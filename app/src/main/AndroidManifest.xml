        <activity
            android:name=".GateActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.RoshanKhata.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Not noHistory (3 Nov 2026 audit, C3): on Android 7-10 the phone's PIN is asked on a screen of its own and
          its answer comes back to this one, which Android never delivers to a noHistory screen (it is closed the
          moment it is hidden), so a PIN-only phone could never be unlocked. Every way out finishes it itself.
        -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!--
          Mera Khata (7 Nov 2026): a shop's khata link opens here. The https link is an App Link (the hosting's
          /.well-known/assetlinks.json names this app's packages and signing keys); the web page's "Open in the
          app" button uses roshankhata://khata?l=…, which works before that check too. Read only, never the book.
          A task of its own (taskAffinity "", 7 Nov 2026): a shop's link opened from the browser never lands on top of
          the book, so Back or Recents from it never shows the book past App Lock.
        -->
        <activity
            android:name=".MeraKhataActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="khata.ehtisham.shop" />
                <data android:pathPrefix="/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="roshankhata" android:host="khata" />
            </intent-filter>
        </activity>

