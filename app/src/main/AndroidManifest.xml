        <!--
          Lets a statement PDF be handed to WhatsApp, Gmail, or the printer
          without exposing the rest of the app's storage. Grants are temporary
          and per-share.
        -->
        <!--
          AndroidX persists the user's chosen app language automatically through
          this disabled holder service (autoStoreLocales). On Android 13+ the
          system takes over; below that AppCompat replays the choice on start.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

            <activity
            android:name=".InsightsActivity"
            android:exported="false" />

        <!--
          Live sync's wake-up (PushWake, 22 Oct 2026): Firebase Cloud Messaging
          delivers the relay's one word "rk-wake" while the app is closed. Only
          in a build that had the owner's google-services file. Auto-init stays
          OFF: no token is made, and Google is not contacted, until a book's
          owner turns the relay on (PushWake.address switches it on).
        -->
        <service
            android:name=".data.WakeService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

