<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cloud backup to the user's own Google Drive -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 17 (targetSdk 37) asks before an app reaches devices on the home network: the phone-to-computer WiFi
      roads (backup send, live sync, "take a shop's book") all do. Declared now so the bump finds it ready; an older
      system ignores the name. The runtime question must be added WITH the bump (8 Nov 2026 review, M22).
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!--
      Receipt printer (5 Oct): talk to a printer the owner already paired in the
      phone's Bluetooth settings. No scanning, so no location and no SCAN
      permission. Bluetooth is not required to install the app.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Used only on the "Import from Contacts" screen, to show the owner their
      contact list so they can pick who to add as a customer. Requested at the
      moment they open that screen, never at launch. Contacts are not uploaded
      or stored; only the ones deliberately chosen are saved. The app works
      fully without this permission — parties can always be added by hand.
    -->
    <!--
      Contacts import, Android 16 and older only (5 Oct 2026). On Android 17
      the system Contact Picker hands over just the contacts the owner picks,
      with no permission at all — Play's Contacts Permissions policy.
    -->
    <uses-permission
        android:name="android.permission.READ_CONTACTS"
        android:maxSdkVersion="36" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Android 7-9 only (23 Oct 2026): a backup or report saved to the public
      Downloads folder needs this before Android 10 (from 10 MediaStore needs
      nothing). Asked at the moment of saving (BaseActivity.withDownloadsAccess),
      never at launch; without it the file still goes to the app's own copy and
      the share sheet.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Hudhud listens himself (13 Nov 2026, ui/HudhudEars): Android's SpeechRecognizer needs the app to hold the
      microphone. Asked only when the owner taps Hudhud's microphone (or in Hudhud's voice settings), with Hudhud's own
      line on why, never at launch. Nothing is recorded or kept: the phone's speech service hands back text, on the
      phone itself when it has the language. Refused, Hudhud uses the phone's voice-search box as before.
      A microphone is not required to install the app (the permission would otherwise make Play require one).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!--
      Android 11 and up hides other apps from this one unless they are named.
      Without this the system's speech recogniser looks absent and the mic
      does nothing at all, silently.
    -->
    <queries>
        <!-- Every app that can send an SMS (PaymentVoice.neverRead): none of them is ever read or listed (8 Nov 2026 review, L154). -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The recogniser's language list (RecognizerIntent.getVoiceDetailsIntent) is found through its WEB_SEARCH activity. -->
        <intent>
            <action android:name="android.speech.action.WEB_SEARCH" />
        </intent>
        <!--
          Android 11+ hides other apps from us unless we declare what we need
          to see. Without this, resolveActivity() for a PDF returns null even
          on a phone that has three PDF viewers installed — so "Open" silently
          fell through to the share sheet and looked identical to "Share".
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <!--
          Payment voice (5 Nov 2026): the phone's speech engines (TextToSpeech's own documentation asks apps
          targeting Android 11 to name this); the SMS apps, only so the default one can be found and NEVER read
          (Telephony.Sms.getDefaultSmsPackage's documentation); and the two wallets offered first, only to say
          whether this phone has them. No QUERY_ALL_PACKAGES.
        -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.provider.Telephony.SMS_DELIVER" />
        </intent>
        <package android:name="com.techlogix.mobilinkcustomer" />
        <package android:name="pk.com.telenor.phoenix" />
    </queries>

