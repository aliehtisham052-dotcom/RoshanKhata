<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Indonesian starting suggestions for the Cashbook category, same order as
      values/arrays.xml. Display text only: the owner's chosen words are
      what is saved, and nothing in the app reads a category back as a key,
      so a translation here cannot break any total.

      This file was missing when the language was added (4 Oct), so a shop
      working in Indonesian was offered "Cash Sale" and "Rent" in English;
      scripts/check_strings.py now checks arrays as well as strings.

      Units of measure are not in this file: see data/UnitWords.kt.
    -->
    <string-array name="cash_categories">
        <item>Penjualan Tunai</item>
        <item>Sewa</item>
        <item>Listrik</item>
        <item>Upah</item>
        <item>Bahan Bakar</item>
        <item>Transportasi</item>
        <item>Perbaikan</item>
        <item>Teh / Minuman</item>
        <item>Alat Tulis</item>
        <item>Sedekah / Amal</item>
        <item>Penarikan Pribadi</item>
        <item>Lainnya</item>
    </string-array>
</resources>
