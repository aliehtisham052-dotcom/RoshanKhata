<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
      Only these two cache folders are exposed, and only for sharing out.
      Nothing else in the app's storage is reachable through this provider.
    -->
    <cache-path
        name="statements"
        path="statements/" />
    <cache-path
        name="backups"
        path="backups/" />
    <cache-path
        name="receipts"
        path="receipts/" />
    <!--
      Where the camera writes. The camera app cannot hand a photo back through
      an app's private storage, so it is given a content:// URI pointing here
      and writes the picture itself. What lands is a working file: it is copied
      into the app's own storage and deleted straight afterwards.
    -->
    <cache-path
        name="camera"
        path="camera/" />
</paths>
