<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages the app ships, for Android 13+ Settings > Apps > Roshan Khata >
  Language. Must list exactly the tags LanguageActivity offers (and that have a
  values-* folder), so the system picker and the in-app picker agree. The app
  already applies them through AppCompatDelegate.setApplicationLocales, which
  is what the system setting drives. Ignored below Android 13.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ur-Latn" />
    <locale android:name="ur" />
    <locale android:name="sd" />
    <locale android:name="fa" />
    <locale android:name="ar" />
</locale-config>
