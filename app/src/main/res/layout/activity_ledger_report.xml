<?xml version="1.0" encoding="utf-8"?>
<!-- The whole-ledger report (24 Oct 2026 redesign, the owner's "local/generic"
     catch): a green band with the title and one-tap period chips, a summary
     card lifted over its foot (window, entry and customer counts, the
     gave/got share bar and the two totals), the entries grouped by day, and
     one primary action at the foot — Share — with Preview and Download as
     icon buttons beside it. There is deliberately no all-customers "net":
     one man's sale and another's payment folded together belong to nobody's
     account (removed from screen and PDF before; see LedgerReportActivity). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/section_khata"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvLedgerReportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/ledger_report_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- One tap per window. Custom asks the first day, then the last. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lrChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipLrToday"
                    style="@style/LedgerReportChip"
                    android:text="@string/range_today" />

                <TextView
                    android:id="@+id/chipLrWeek"
                    style="@style/LedgerReportChip"
                    android:text="@string/range_this_week" />

                <TextView
                    android:id="@+id/chipLrMonth"
                    style="@style/LedgerReportChip"
                    android:text="@string/range_this_month" />

                <TextView
                    android:id="@+id/chipLrAll"
                    style="@style/LedgerReportChip"
                    android:text="@string/range_all" />

                <TextView
                    android:id="@+id/chipLrCustom"
                    style="@style/LedgerReportChip"
                    android:layout_marginEnd="0dp"
                    android:drawablePadding="6dp"
                    android:text="@string/range_custom"
                    app:drawableStartCompat="@drawable/ic_lr_calendar" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- The card rises 48dp into the band's foot: ConstraintLayout ignores a
         negative margin, so it hangs from this marker instead. -->
    <Space
        android:id="@+id/lrOverlap"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="@id/header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lrSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/lrOverlap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLrCounts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- The window itself, tappable: the same as Custom. -->
                <TextView
                    android:id="@+id/tvLrRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_lr_range_pill"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_lr_calendar"
                    app:drawableTint="@color/text_muted" />
            </LinearLayout>

            <!-- Gave against got, as a share of the window's money. -->
            <LinearLayout
                android:id="@+id/lrShareBar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_lr_bar_track"
                android:orientation="horizontal">

                <View
                    android:id="@+id/lrShareGave"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/lr_bar_gave" />

                <View
                    android:id="@+id/lrShareGot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/lr_bar_got" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_lr_total_gave"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:text="@string/i_gave"
                        android:textColor="@color/red_gave_text"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_lr_arrow_gave"
                        app:drawableTint="@color/red_gave_text" />

                    <TextView
                        android:id="@+id/tvLrTotalGave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:textColor="@color/red_gave_text"
                        android:textSize="18sp"
                        android:textAlignment="viewStart"
                        app:autoSizeMaxTextSize="18sp"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_lr_total_got"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:text="@string/i_got"
                        android:textColor="@color/green_got_text"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_lr_arrow_got"
                        app:drawableTint="@color/green_got_text" />

                    <TextView
                        android:id="@+id/tvLrTotalGot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:textColor="@color/green_got_text"
                        android:textSize="18sp"
                        android:textAlignment="viewStart"
                        app:autoSizeMaxTextSize="18sp"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLedgerReport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lrSummary" />

    <TextView
        android:id="@+id/tvLrEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="@string/ledger_report_empty"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lrSummary" />

    <!-- One primary action. Preview and Download are icon buttons with
         their names spoken (contentDescription) and shown on long press. -->
    <LinearLayout
        android:id="@+id/lrActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_lr_action_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLrPreview"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/pdf_preview"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_eye_open"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/ink"
            app:strokeColor="@color/text_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLrDownload"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/ledger_report_download"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/ink"
            app:strokeColor="@color/text_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLrShare"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/share"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/section_khata"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
