<?xml version="1.0" encoding="utf-8"?>
<!--
  Poster & Status: pick an occasion, change the two lines if you like, share.
  The preview is the real picture, drawn the same way as the one that is sent.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/poster_title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/poster_subtitle"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/poster_title"
            android:scaleType="fitCenter" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipOccasions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/ProfileField"
            android:hint="@string/poster_heading_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPosterTitle"
                style="@style/ProfileFieldInput"
                android:inputType="textCapSentences"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/ProfileField"
            android:hint="@string/poster_message_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPosterMessage"
                style="@style/ProfileFieldInput"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="160" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPosterLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/poster_show_logo"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPosterMark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/poster_show_mark"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSharePoster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="@string/share"
            app:icon="@drawable/ic_share" />
    </LinearLayout>
</ScrollView>
