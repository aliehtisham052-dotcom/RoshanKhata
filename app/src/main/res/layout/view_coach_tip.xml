<?xml version="1.0" encoding="utf-8"?>
<!--
  The Home walkthrough card — one card for every step, header and tiles
  alike, so the tour reads as one thing: "4 / 18" and a thin progress bar
  instead of a separate count up top and bare dots below.

  It sits right under the lit item with a notch pointing up at it; when the
  item is too low for that, it sits above with the notch pointing down.
  CoachMarkController places it and picks the notch.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- The notch. Moved sideways in code to sit under the lit item's centre;
         absolute left on purpose — it follows a measured x, not reading order. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="8dp">

        <ImageView
            android:id="@+id/coachTipPointer"
            android:layout_width="16dp"
            android:layout_height="8dp"
            android:layout_gravity="left"
            android:importantForAccessibility="no"
            android:src="@drawable/coach_tip_pointer"
            tools:ignore="RtlHardcoded" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_coach_tip"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTipCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:textColor="@color/gold_accent"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Progress: two weighted halves, set in code. -->
            <LinearLayout
                android:layout_width="84dp"
                android:layout_height="4dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/coachTipDone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/coach_progress_fill" />

                <View
                    android:id="@+id/coachTipRest"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/coach_progress_track" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTipTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTipDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/coach_tip_body"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTipSkip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/coach_skip"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTipNext"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:minWidth="104dp"
                android:text="@string/coach_next"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_green"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark"
                app:strokeWidth="1.5dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The notch when the card sits ABOVE the lit item. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="8dp">

        <ImageView
            android:id="@+id/coachTipPointerDown"
            android:layout_width="16dp"
            android:layout_height="8dp"
            android:layout_gravity="left"
            android:importantForAccessibility="no"
            android:rotation="180"
            android:src="@drawable/coach_tip_pointer"
            android:visibility="invisible"
            tools:ignore="RtlHardcoded" />
    </FrameLayout>
</LinearLayout>
