<?xml version="1.0" encoding="utf-8"?>
<!--
  The walkthrough card for the Home HEADER steps (net balance, I have to get,
  I have to give). It sits directly under the lit item with a notch pointing
  up at it, and counts only the header steps ("1 / 3"), so the owner sees
  how short this part is.

  The tile steps below keep their own card, view_coach_bubble — unchanged.
  CoachMarkController shows one or the other per step.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- The notch. Moved sideways in code to sit under the lit item's centre;
         absolute left on purpose — it follows a measured x, not reading order. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="8dp">

        <ImageView
            android:id="@+id/coachTipPointer"
            android:layout_width="16dp"
            android:layout_height="8dp"
            android:layout_gravity="left"
            android:importantForAccessibility="no"
            android:src="@drawable/coach_tip_pointer"
            tools:ignore="RtlHardcoded" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_coach_tip"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTipCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:textColor="@color/gold_accent"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/coachTipDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTipTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTipDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/coach_tip_body"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTipSkip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/coach_skip"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTipNext"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:minWidth="104dp"
                android:text="@string/coach_next"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_green"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark"
                app:strokeWidth="1.5dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
