<?xml version="1.0" encoding="utf-8"?>
<!--
  The Home walkthrough sheet (9 Oct): one card pinned to the foot of the
  screen for every step, so the words are always in the same place and only
  the spotlight above moves. "2 / 6" and a thin progress bar, the item's
  name, one sentence, Skip and Next. CoachMarkController fills it and adds
  the gesture bar's height to the bottom padding.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_coach_sheet"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <!-- The grab line every bottom sheet carries: says "a sheet", not "a dialog". -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/coach_progress_track" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTipCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:textColor="@color/gold_accent"
            android:textDirection="ltr"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Progress: two weighted halves, set in code. -->
        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="4dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/coachTipDone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/coach_progress_fill" />

            <View
                android:id="@+id/coachTipRest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/coach_progress_track" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTipTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="viewStart"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTipDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingMultiplier="1.15"
        android:minLines="2"
        android:textAlignment="viewStart"
        android:textColor="@color/coach_tip_body"
        android:textSize="14.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTipSkip"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/coach_skip"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTipNext"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:minWidth="120dp"
            android:text="@string/coach_next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
