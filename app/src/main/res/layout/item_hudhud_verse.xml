<?xml version="1.0" encoding="utf-8"?>
<!--
  A verse under Hudhud's words (14 Nov 2026, HudhudFaith): the Arabic as text, in the Arabic font and laid out from the
  right whatever the app's language, with the surah's name and the verse's place under it. Never said aloud, never a
  button. The text may be long (a whole verse): it wraps, every size is sp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_hudhud_verse"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvVerseArabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.45"
        android:textAlignment="viewStart"
        android:textColor="@color/ink"
        android:textDirection="rtl"
        android:textLocale="ar"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvVerseRef"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAlignment="viewStart"
        android:textColor="@color/brand_green_text"
        android:textDirection="rtl"
        android:textLocale="ar"
        android:textSize="13sp" />
</LinearLayout>
