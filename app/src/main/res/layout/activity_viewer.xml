<?xml version="1.0" encoding="utf-8"?>
<!--
  The read-only phone's screen (3 Oct 2026). Two faces, one shown at a time:
  viewerStatus on a read-only phone (what copy is this, refresh, turn off),
  viewerSetup on a normal phone (send a copy to a helper, or make this phone
  read-only). See ViewerMode for why the role is safe by construction.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/section_tools"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/viewer_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/viewer_subtitle"
                android:textColor="@color/section_tools_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== A read-only phone ===== -->
        <LinearLayout
            android:id="@+id/viewerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/note_bg"
                android:padding="14dp"
                android:text="@string/viewer_on_note"
                android:textColor="@color/note_text"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvViewerShop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvViewerDataAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvViewerRefreshedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvViewerSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewerRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/viewer_refresh"
                    android:textSize="15sp"
                    app:backgroundTint="@color/brand_green"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewerLeave"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/viewer_leave"
                    android:textColor="@color/red_gave_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== A normal phone ===== -->
        <LinearLayout
            android:id="@+id/viewerSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/viewer_share_title"
                android:textColor="@color/brand_green_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/viewer_share_body"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewerSendFile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/viewer_send_file"
                android:textSize="15sp"
                app:backgroundTint="@color/brand_green"
                app:cornerRadius="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/viewer_setup_title"
                android:textColor="@color/brand_green_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/note_bg"
                android:padding="12dp"
                android:text="@string/viewer_setup_body"
                android:textColor="@color/note_text"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewerFromFile"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/viewer_from_file"
                android:textColor="@color/brand_green_text"
                android:textSize="15sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/brand_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewerFromDrive"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="@string/viewer_from_drive"
                android:textColor="@color/brand_green_text"
                android:textSize="15sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/brand_green" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
