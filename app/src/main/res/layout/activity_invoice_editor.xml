<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/editorToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:theme="@style/ToolbarInk"
        app:title="@string/add_invoice"
        app:titleTextColor="@color/white" />

    <!--
      One step at a time, in the owner's own order: customer, then items,
      then the design. The header continues the toolbar's brand green, with
      three gold bars showing how far along the invoice is — the pale
      grey-green strip it replaces read as a different app.
    -->
    <LinearLayout
        android:id="@+id/stepHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/brand_green"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editorToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/stepBar1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_step_bar" />

            <View
                android:id="@+id/stepBar2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_step_bar" />

            <View
                android:id="@+id/stepBar3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_step_bar" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/header_on_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepHeader">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- Step 1: customer, then the invoice's own details, each in a card -->
            <LinearLayout
                android:id="@+id/stepCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_editor_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/EditorSectionLabel"
                        android:text="@string/invoice_section_customer" />

                    <AutoCompleteTextView
                        android:id="@+id/etInvoiceCustomer"
                        style="@style/EditorField"
                        android:completionThreshold="1"
                        android:drawableStart="@drawable/ic_person"
                        android:hint="@string/invoice_customer_hint"
                        android:inputType="textPersonName|textCapWords" />

                    <EditText
                        android:id="@+id/etInvoicePhone"
                        android:textDirection="ltr"
                        android:textAlignment="viewStart"
                        style="@style/EditorField"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_phone"
                        android:hint="@string/invoice_phone_hint"
                        android:inputType="phone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_editor_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/EditorSectionLabel"
                        android:text="@string/invoice_section_details" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInvoiceDate"
                            style="@style/EditorDateButton"
                            android:text="@string/pick_invoice_date" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInvoiceDueDate"
                            style="@style/EditorDateButton"
                            android:layout_marginStart="8dp"
                            android:text="@string/invoice_due_date_hint"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <!--
                      Blank means "assign the next number automatically" — the
                      hint shows which number that will be (set in code), and
                      the owner types one here only to use their own paper
                      series or correct a number, same as Vyapar's Change
                      Invoice No.
                    -->
                    <EditText
                        android:id="@+id/etInvoiceNumber"
                        style="@style/EditorField"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_hash"
                        android:hint="@string/invoice_number_hint"
                        android:inputType="text" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 2: items -->
            <LinearLayout
                android:id="@+id/stepItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/itemRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddRow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:text="@string/add_item"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_green"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_add_plain"
                    app:iconGravity="textStart"
                    app:iconTint="@color/brand_green"
                    app:strokeColor="@color/brand_green"
                    app:strokeWidth="1.5dp" />

                <!--
                  Discount, tax, extra charge, received and note all moved
                  into one dialog behind this button — the owner asked for
                  the optional things to live in their own box so this step
                  stays just the items.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMoreOptions"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:text="@string/invoice_more_options"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_tune"
                    app:iconGravity="start"
                    app:iconTint="@color/brand_green"
                    app:strokeColor="@color/editor_card_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Step 3: design, with the preview under it -->
            <LinearLayout
                android:id="@+id/stepDesign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!--
                  One template per slide, swiped through — not a vertical
                  list of names with a single preview below it. The owner
                  asked for this specifically ahead of the other eight
                  templates being built, so the pattern is right before it
                  is repeated ten times over.
                -->
                <TextView
                    android:id="@+id/tvTemplateCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="460dp"
                    android:layout_marginTop="8dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpTemplates"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ProgressBar
                        android:id="@+id/pbPreviewLoading"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>

                <!--
                  Without these there is nothing on screen saying more
                  designs exist — the owner had no way to know the carousel
                  could be swiped at all.
                -->
                <LinearLayout
                    android:id="@+id/templateDots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/tvSwipeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!--
          The running total while items are being typed (Step 2 only). The
          owner used to see the figure for the first time on the finished
          PDF; a wrong rate now shows up here, before the invoice exists.
          Worked out by InvoiceMath.totals — the same function the PDF uses —
          so the two can never disagree.
        -->
        <LinearLayout
            android:id="@+id/itemsTotalBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_green_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvItemsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/brand_green"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvItemsTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_green"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/invoice_back"
                android:textColor="@color/brand_green"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="14dp"
                app:strokeColor="@color/brand_green"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/invoice_next"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/brand_green"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="8dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark"
                app:strokeWidth="1.5dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
