<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/editorToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/section_tools"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:theme="@style/ToolbarInk"
        app:title="@string/add_invoice"
        app:titleTextColor="@color/white" />

    <!--
      One step at a time, in the owner's own order: customer, then items,
      then the design. Asked for repeatedly, and modelled on the walkthrough
      the app already uses for onboarding rather than a single long form.
    -->
    <TextView
        android:id="@+id/tvStep"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/section_tools_soft"
        android:padding="10dp"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editorToolbar" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStep">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Step 1: customer -->
            <LinearLayout
                android:id="@+id/stepCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <AutoCompleteTextView
                    android:id="@+id/etInvoiceCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="1"
                    android:hint="@string/invoice_customer_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/etInvoicePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/invoice_phone_hint"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:textSize="17sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInvoiceDate"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/pick_invoice_date"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInvoiceDueDate"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/invoice_due_date_hint"
                    app:cornerRadius="8dp" />

                <!--
                  Blank means "assign the next number automatically" — the
                  owner types one here only to use their own paper series or
                  correct a number, same as Vyapar's Change Invoice No.
                -->
                <EditText
                    android:id="@+id/etInvoiceNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="@string/invoice_number_hint"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Step 2: items -->
            <LinearLayout
                android:id="@+id/stepItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/itemRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddRow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/add_item"
                    app:cornerRadius="8dp" />

                <!--
                  Discount, tax, extra charge, received and note all moved
                  into one dialog behind this button — the owner asked for
                  the optional things to live in their own box so this step
                  stays just the items.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMoreOptions"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/invoice_more_options"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Step 3: design, with the preview under it -->
            <LinearLayout
                android:id="@+id/stepDesign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!--
                  One template per slide, swiped through — not a vertical
                  list of names with a single preview below it. The owner
                  asked for this specifically ahead of the other eight
                  templates being built, so the pattern is right before it
                  is repeated ten times over.
                -->
                <TextView
                    android:id="@+id/tvTemplateCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="460dp"
                    android:layout_marginTop="8dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpTemplates"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ProgressBar
                        android:id="@+id/pbPreviewLoading"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>

                <!--
                  Without these there is nothing on screen saying more
                  designs exist — the owner had no way to know the carousel
                  could be swiped at all.
                -->
                <LinearLayout
                    android:id="@+id/templateDots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/tvSwipeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <!--
                  Shop name, address, stamp, payment QR, bank details, and
                  the standing Terms & Conditions all print on the invoice
                  from here — the owner asked where to set them, since
                  nothing on this screen itself pointed there.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShopDetails"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/invoice_edit_shop_details"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/invoice_back"
            android:visibility="gone"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/invoice_next"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="10dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
