<?xml version="1.0" encoding="utf-8"?>
<!--
  The customer's signature (redesigned 18 Oct). A whole screen, not a small
  pop-up: the phone is handed to the customer, so it shows plainly WHAT is
  being signed for (who, which way, how much, when) above a large pad.
  Undo takes back one stroke, Clear the lot; Save stays off until there is
  ink. The pad itself is always white — the signature is a document.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sigRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- Top bar: close, and what this screen is. -->
    <LinearLayout
        android:id="@+id/sigTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnSigClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_close"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/sig_label"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- What is being signed for. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sigSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/page_line"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvSigParty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSigDirection"
                android:backgroundTint="@color/red_gave"
                android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_entry_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSigAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textDirection="ltr"
                    android:textAlignment="viewStart"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSigDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:text="@string/sig_hint"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <!-- The pad: as much of the screen as is left. -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:minHeight="200dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/editor_field_stroke"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.innovation313.roshankhata.ui.SignaturePad
                android:id="@+id/sigPad"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Fades once the first stroke goes down. Not touchable: the pad takes every touch.
                 #86827A on the white pad clears 3:1 (EveryLayoutReadableInDarkTest). -->
            <TextView
                android:id="@+id/tvSigPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/sig_title"
                android:textColor="#86827A"
                android:textSize="22sp"
                android:textStyle="italic" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Undo one stroke, or clear them all. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSigUndo"
            android:letterSpacing="0"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:enabled="false"
            android:text="@string/sig_undo"
            android:textAllCaps="false"
            android:textColor="@color/brand_green_text"
            android:textSize="15sp"
            app:icon="@drawable/ic_undo"
            app:iconTint="@color/brand_green_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSigClear"
            android:letterSpacing="0"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:enabled="false"
            android:text="@string/sig_clear"
            android:textAllCaps="false"
            android:textColor="@color/red_gave_text"
            android:textSize="15sp"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/red_gave_text" />
    </LinearLayout>

    <!-- Pinned at the foot, under the thumb. -->
    <LinearLayout
        android:id="@+id/sigFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSigCancel"
            android:letterSpacing="0"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/editor_field_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSigSave"
            android:letterSpacing="0"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1.4"
            app:backgroundTint="@color/brand_green"
            android:text="@string/sig_save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_check_plain"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
