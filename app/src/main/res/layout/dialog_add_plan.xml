<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plan_dialog_help"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <AutoCompleteTextView
            android:popupBackground="@drawable/bg_dropdown_popup"
            android:dropDownVerticalOffset="4dp"
            android:id="@+id/etPlanParty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:completionThreshold="1"
            android:hint="@string/cheque_party_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvPlanOwes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/brand_green_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPlanTotal"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/plan_total_hint"
            android:digits="0123456789.+−×÷*/-%"
            android:importantForAutofill="no"
            android:inputType="phone" />

        <TextView
            android:id="@+id/tvPlanTotalResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/brand_green_text"
            android:textDirection="ltr"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etPlanInstallment"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/plan_installment_hint"
            android:digits="0123456789.+−×÷*/-%"
            android:importantForAutofill="no"
            android:inputType="phone" />

        <TextView
            android:id="@+id/tvPlanInstallmentResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/brand_green_text"
            android:textDirection="ltr"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- One pad for both amounts (21 Oct): it types into whichever of
             the two has the focus and steps aside for the party and note
             boxes (CalcPad.bindAll). -->
        <include
            android:id="@+id/planKeypad"
            layout="@layout/view_calculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlanDueDate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="@color/ink"
        app:strokeColor="@color/editor_field_stroke"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/plan_pick_next_due"
            app:cornerRadius="8dp" />

        <EditText
            android:id="@+id/etPlanNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/note_optional"
            android:importantForAutofill="no"
            android:inputType="text" />

    </LinearLayout>
</ScrollView>
