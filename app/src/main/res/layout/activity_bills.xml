<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/section_bills"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/supplier_bills"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/bills_subtitle"
            android:textColor="@color/section_bills_soft"
            android:textSize="13sp" />

        <!-- Three tools as equal tiles, icon over a short label (13 Oct).
             Three full-width outlined buttons cut "Where is it cheaper?
             Purchase rates" in half and filled the header with lines. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrace"
                style="@style/HeaderTileButton"
                android:text="@string/trace_batch"
                app:icon="@drawable/ic_search" />

            <!-- "Where is it cheaper?" (6 Oct): purchase rates by product and supplier. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSupplierRates"
                style="@style/HeaderTileButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/sr_open"
                android:text="@string/sr_open_short"
                app:icon="@drawable/ic_tile_supplier_rates" />

            <!-- C1 (2 Oct): schemes are bought towards on these very bills. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSchemes"
                style="@style/HeaderTileButton"
                android:layout_marginStart="8dp"
                android:text="@string/schemes_title"
                app:icon="@drawable/ic_tile_season" />
        </LinearLayout>

        <!-- Expiry is the thing that quietly costs money, so it gets a banner,
             not a menu item three taps away. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExpiring"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/expiring_stock"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/red_gave"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_tile_expiring"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>

    <!-- The page at a glance (13 Oct): how many bills, what is still owed to
         the suppliers on them, and how much stock is near its expiry. -->
    <LinearLayout
        android:id="@+id/billStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout style="@style/StatTile">
            <TextView android:id="@+id/tvStatBills" style="@style/StatTileValue" />
            <TextView style="@style/StatTileLabel" android:text="@string/stat_bills" />
        </LinearLayout>

        <LinearLayout style="@style/StatTile" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tvStatOwe" style="@style/StatTileValue" android:textColor="@color/green_got_text" />
            <TextView style="@style/StatTileLabel" android:text="@string/stat_you_owe" />
        </LinearLayout>

        <LinearLayout style="@style/StatTile" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tvStatExpiring" style="@style/StatTileValue" android:textColor="@color/red_gave_text" />
            <TextView style="@style/StatTileLabel" android:text="@string/stat_expiring" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvBillNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_note_card"
        android:drawablePadding="10dp"
        android:padding="12dp"
        android:text="@string/bill_ledger_note"
        android:textColor="@color/note_text"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/billStats" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBills"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBillNote" />

    <!-- Empty: a picture, the reason a bill is worth entering, and the way
         to enter the first one (13 Oct). -->
    <LinearLayout
        android:id="@+id/emptyBills"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvBills"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvBills">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_empty_icon_bills">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tile_bills" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNoBills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/no_bills"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFirstBill"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/bills_add_first"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/section_bills"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddBill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/add_bill"
        android:textColor="@color/white"
        app:backgroundTint="@color/button_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
