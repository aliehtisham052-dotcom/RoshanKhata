<?xml version="1.0" encoding="utf-8"?>
<!--
  One choice on the chooser sheet (10 Oct): a white card with a hairline,
  chosen = a 2dp brand-green ring on a faint green fill with a green tick -
  the same card and tick as the shop-type picker (bg_trade_card), so every
  "pick one" in the app looks alike. The tile holds an icon or a short
  glyph ("Aa", "Rs", "A-Z").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_trade_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/choiceTile"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_tile_icon">

        <ImageView
            android:id="@+id/ivChoiceIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvChoiceGlyph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChoiceRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChoiceRowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAlignment="viewStart"
            android:textColor="@color/ink_soft"
            android:textSize="12.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/choiceTick"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_trade_check"
        android:visibility="invisible">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_plain"
            app:tint="@color/white" />
    </FrameLayout>
</LinearLayout>
