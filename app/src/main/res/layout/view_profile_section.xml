<?xml version="1.0" encoding="utf-8"?>
<!--
  The header of one Profile section (13 Oct 2026). The whole row is the
  button: tap to fold the section away or open it. Folded, the second line
  says what the section already holds ("Rs, PKR · Agriculture"), so the
  owner sees the page at a glance instead of scrolling one long form.
  Title, icon and summary are set by ProfileSections.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_section_icon">

        <ImageView
            android:id="@+id/ivSectionIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/brand_green_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:textAlignment="viewStart"
            android:id="@+id/tvSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:textAlignment="viewStart"
            android:id="@+id/tvSectionSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivSectionChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_down"
        app:tint="@color/text_muted" />
</LinearLayout>
