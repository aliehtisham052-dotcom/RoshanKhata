<?xml version="1.0" encoding="utf-8"?>
<!--
  A restore's steps (3 Nov 2026, the owner's mockup "Restore steps"): the title, which backup, each step
  ticked as it really finishes, then what to know and Open the book. ui/RestoreSteps builds the rows
  (item_restore_step) into stepsList. The title and the backup's line stay in sight above the steps, and the
  button below them; only the steps and what to know scroll (the proof pictures at 150%: the button went below
  the dialog's edge when it scrolled with them, and "Restored" went above it once the note was brought in).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvStepsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="24dp"
        android:accessibilityHeading="true"
        android:accessibilityLiveRegion="polite"
        android:textAlignment="viewStart"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStepsSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="24dp"
        android:textAlignment="viewStart"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Its edges fade where more lies beyond them, so a step cut by the edge reads as "more above". -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/stepsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fadingEdgeLength="28dp"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/stepsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvStepsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textAlignment="viewStart"
                android:textColor="@color/ink_soft"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStepsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/restore_keep_open"
                android:textAlignment="viewStart"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStepsDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="18dp"
        android:minHeight="52dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/brand_green"
        app:cornerRadius="14dp" />
</LinearLayout>
