<?xml version="1.0" encoding="utf-8"?>
<!--
  The Settings sheet (7 Oct): Home's gear and the Khata screen's ⋮ both
  open this. It replaces the ⋮ popup — ten rows in one unbroken column with
  a "Home" door among the settings — with the groups a shopkeeper actually
  thinks in: Security, Data, Display, Help. Each group is a paper card of
  rows (item_more_row, a hairline between them), the same card as a party
  on the Khata list, under a small capital label. The rows are built in
  MoreSheet.showMenu from the one list every door comes from, so the two
  screens can never drift apart again.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_sheet_grabber" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_tile_icon"
                android:backgroundTint="@color/tile_settings_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tile_settings" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/more_settings"
                android:textColor="@color/ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- The Khata screen's way home (7 Oct), a deep-green pill in the
                 sheet's title row; gone on Home itself. It was the first row
                 of the settings list, which is not where a door belongs. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetHome"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="@string/nav_home"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/brand_green"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_menu_home"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- The groups land here. -->
        <LinearLayout
            android:id="@+id/settingsGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
