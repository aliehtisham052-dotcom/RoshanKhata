<?xml version="1.0" encoding="utf-8"?>
<!--
  A statement being made (3 Nov 2026, the owner's mockup "Statement PDF — pages being made"): its pages joining
  the stack as the writer finishes them, and which page it is on. Shown only when making takes longer than
  0.4 s (ui/PdfMaking); the ready dialog follows as before.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <com.innovation313.roshankhata.ui.PageStack
        android:id="@+id/pdfStack"
        android:layout_width="120dp"
        android:layout_height="132dp" />

    <TextView
        android:id="@+id/tvPdfPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:minHeight="20dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />
</LinearLayout>
