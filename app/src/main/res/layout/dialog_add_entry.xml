<?xml version="1.0" encoding="utf-8"?>
<!--
  The entry form (I Gave / I Got), full screen.

  Top to bottom, the order a shopkeeper reads it in:
    header   who and which way, live: "Ahmad ko diye · Rs 555"
    card     the amount, then three chips: note/goods, bill photo, date
    stepOne  what the spare space is for: balance preview (I Gave),
             quick shares and payment method (I Got)
    stepTwo  the details (note, goods, rate, batch, qarz-e-hasna, recovery)
    bottom   SAVE, full width, pinned above the keypad

  The header, band, SAVE and preview start GONE: PlansActivity reuses this
  layout inside its own titled dialog with its own buttons, and must look as
  it always has. PartyDetailActivity turns them on.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/entryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnEntryBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEntryDirection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_entry_pill"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEntryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/entryScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- The header's green carried under the top of the card, so the
                 card sits on the header rather than below it. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/entryHeaderBand"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_header_gradient"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/entryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_entry_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_entry_amount"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/currency_rs"
                            android:textColor="@color/text_muted"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/etAmount"
                                android:textDirection="ltr"
                                android:textAlignment="viewStart"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:cursorVisible="true"
                                android:digits="0123456789.+−×÷*/-%"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:gravity="center_vertical"
                                android:hint="@string/amount"
                                android:importantForAutofill="no"
                                android:inputType="phone"
                                android:maxLines="1"
                                android:textColor="@color/ink"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <!-- The running total of a sum, green, under what was typed. -->
                            <TextView
                                android:id="@+id/tvAmountResult"
                                android:textDirection="ltr"
                                android:textAlignment="viewStart"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:maxLines="1"
                                android:textColor="@color/brand_green_text"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Backspace sits in the box, where the thumb already is.
                             A Button (MaterialButton), because the key binding
                             finds it as one. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/calcBack"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:contentDescription="@string/calc_backspace"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:text="@string/calc_backspace"
                            android:textColor="@color/ink_soft"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <!-- Three chips, one row, equal thirds. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMoreDetails"
                            style="@style/EntryChip"
                            android:layout_width="0dp"
                            android:layout_weight="1.3"
                            android:text="@string/entry_details_chip" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddBill"
                            style="@style/EntryChip"
                            android:layout_width="0dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/entry_bill_chip" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEntryDate"
                            style="@style/EntryChip"
                            android:layout_width="0dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="0.9" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Step one: what the spare space under the card is for. -->
            <LinearLayout
                android:id="@+id/stepOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- I Gave: where the customer's balance lands after this entry. -->
                <LinearLayout
                    android:id="@+id/entryBalancePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_entry_preview"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPreviewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/brand_green_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

        <LinearLayout
            android:id="@+id/quickAmounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvQuickAmountLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuarter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/quick_amount_quarter"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHalf"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/quick_amount_half"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnThreeQuarter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/quick_amount_three_quarter"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFullAmount"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/quick_amount_full"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/paymentMethodSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/payment_method_label"
                android:textColor="@color/brand_green_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!--
              No selectionRequired: a chip already tapped can be tapped off
              again. "I did not record how" is a real answer and must stay
              reachable, or the first tap becomes permanent.
            -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCash"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textColor="@color/choice_chip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_method_cash" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBank"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textColor="@color/choice_chip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_method_bank" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCheque"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textColor="@color/choice_chip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_method_cheque" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOnline"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:textColor="@color/choice_chip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_method_online" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/stepTwo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!--
          The note: a settled three lines. Free text deserves more than one
          line to write in, and a fixed height gives it that without making the
          field's size depend on how tall the phone happens to be.
        -->
        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/note_optional"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="48dp"
            android:minLines="1"
            android:scrollbars="vertical" />

        <!-- Goods, if any moved. Optional — a cash-only entry skips this. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/goods_section"
            android:textColor="@color/brand_green_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goods_help"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <AutoCompleteTextView
            android:id="@+id/etItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/item_name_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:completionThreshold="1" />

        <LinearLayout
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etQuantity"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/quantity_hint"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <AutoCompleteTextView
                android:id="@+id/etUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:completionThreshold="1"
                android:hint="@string/unit_hint"
                android:importantForAutofill="no"
                android:inputType="text" />
        </LinearLayout>

        <!--
          Shown only for a sale, and only once a product with a recorded batch
          is recognised. A cash sale or an unrecognised item name never shows
          this — asking for a batch that cannot exist is worse than not asking.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRateSuggestion"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textAllCaps="false"
            android:textColor="@color/brand_green_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatch"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/pick_batch"
            android:visibility="gone"
            app:cornerRadius="8dp" />

        <!-- An equal share of whatever the page has spare. -->

        <!--
          How the money arrived. Shown only on an "I Got" entry: goods handed
          over on udhar were not paid by any method, and recording one against
          them would put a falsehood on the statement.
          
          Optional throughout. An owner who does not say leaves it blank, and
          blank is stored as blank — never quietly filed as cash.
        -->
        

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbQarzeHasna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/qarze_hasna"
            android:textSize="14sp" />

        <TextView
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qarze_hasna_help"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- An equal share of whatever the page has spare. -->


        <TextView
            android:id="@+id/tvRecoveryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recovery_label"
            android:textColor="@color/brand_green_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:layout_marginTop="8dp"
            android:id="@+id/rgRecovery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCertain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/recovery_certain"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbDoubtful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/recovery_doubtful"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- An equal share of whatever the page has spare. -->

        </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Pinned: SAVE right above the keys, both under the thumb. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntrySave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.08"
            android:text="@string/save"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="26dp" />

        <include
            android:id="@+id/entryKeypad"
            layout="@layout/view_calculator"
            android:layout_width="match_parent"
            android:layout_height="330dp" />
    </LinearLayout>
</LinearLayout>
