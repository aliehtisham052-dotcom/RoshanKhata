<?xml version="1.0" encoding="utf-8"?>
<!--
  The entry form, shown full screen rather than as a card floating over the
  ledger. Writing an entry is the one thing this app is for; it gets the
  screen.

  fillViewport so the content reaches the bottom on a tall phone instead of
  huddling at the top with a field of white beneath it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!--
          Step one: the amount, and the two things that qualify it. Everything
          else waits behind "more details" — an entry is usually just a figure,
          and a shopkeeper at the counter should not scroll past goods and
          recovery to reach Save.
        -->
        <LinearLayout
            android:id="@+id/stepOne"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/amount"
            android:importantForAutofill="no"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:cursorVisible="true"
            android:inputType="phone"
            android:digits="0123456789.+−×÷*/-%" />

        <!--
          The running total, the moment there is a sum to total. The pad had an
          equals key and nothing else, so "3500-32%" sat there looking like
          text until it was pressed — while the Calculator screen answered as
          you typed. Same behaviour in both places now.
        -->
        <TextView
            android:id="@+id/tvAmountResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/brand_green"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!--
          The bill and the date, above the pad rather than below it.

          They sit with the amount because they belong to it — both answer
          "which transaction was this" rather than "how much" — and because
          the pad now takes whatever height is left. Anything under the pad
          would be pushed towards the bottom of the screen and, on a short
          phone, off it. Neither needs a whole row. The photo stays on this
          phone and out of statements, the same way a customer's photo does;
          the date defaults to now.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddBill"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="2dp"
                android:text="@string/add_bill_photo"
                android:textAllCaps="false"
                android:textColor="@color/brand_green"
                android:textSize="12sp"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="18dp"
                app:iconTint="@color/brand_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntryDate"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="2dp"
                android:textAllCaps="false"
                android:textColor="@color/brand_green"
                android:textSize="12sp"
                app:icon="@drawable/ic_calendar"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="18dp"
                app:iconTint="@color/brand_green" />
        </LinearLayout>

        <!--
          The system keyboard is suppressed on the amount field; this pad is
          the only input. That keeps entry to a single, familiar number pad
          instead of a keyboard plus a separate strip.

          Weighted, so the pad takes the whole of what the amount field, the
          bill row and the link below them leave behind. It used to be a fixed
          block of keys with a field of white under it — on a tall phone,
          nearly a third of the screen doing nothing while the keys stayed
          small. The pad carries its own floor, so on a short phone it stops
          shrinking and the screen scrolls instead.
        -->
        <include
            layout="@layout/view_calculator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          The way through to the rest. A row rather than a dialog button,
          because it is an offer and not a step: Save sits beside it and works
          without ever coming here.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMoreDetails"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="start|center_vertical"
            android:text="@string/more_details"
            android:textAllCaps="false"
            android:textColor="@color/ink_soft"
            android:textSize="13sp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="end"
            app:iconSize="18dp"
            app:iconTint="@color/ink_soft" />

        </LinearLayout>

        <!--
          Step two: everything an entry may carry and usually does not.
        -->
        <LinearLayout
            android:id="@+id/stepTwo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/note_optional"
            android:importantForAutofill="no"
            android:inputType="text" />

        <!-- Goods, if any moved. Optional — a cash-only entry skips this. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/goods_section"
            android:textColor="@color/navy_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goods_help"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/item_name_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/quantity_hint"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <AutoCompleteTextView
                android:id="@+id/etUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:completionThreshold="1"
                android:hint="@string/unit_hint"
                android:importantForAutofill="no"
                android:inputType="text" />
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbQarzeHasna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/qarze_hasna"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qarze_hasna_help"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvRecoveryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/recovery_label"
            android:textColor="@color/navy_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgRecovery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCertain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/recovery_certain"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbDoubtful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/recovery_doubtful"
                android:textSize="13sp" />
        </RadioGroup>

        <!--
          Empty space that gives way.

          This page is shorter than the screen, so it ended half way up with
          white beneath it. A spacer takes that up and carries Save down to
          the bottom where it belongs.

          It is a spacer and not a stretched form on purpose. Stretching the
          fields themselves would fit this page to this phone and clip it on a
          smaller one, or at a larger font size — and a clipped field on an
          entry form is a good deal worse than an empty margin. A weighted
          spacer only ever takes what is spare: when the form is taller than
          the screen it collapses to nothing and the page scrolls as before.
        -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
