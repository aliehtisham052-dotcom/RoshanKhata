<?xml version="1.0" encoding="utf-8"?>
<!--
  One language on the language page (5 Nov 2026, the owner's approved setup mockup): the
  language's own name in its own script, under it its name in the app's language (left out
  when the two are one language), the "Phone's language" tag on the phone's own, and a radio.
  The trade card's look (bg_trade_card): chosen = the green ring on a faint green fill. Words
  are stacked, never beside each other, so 150% text on a 360 dp phone still fits (lesson 58).
  Filled by LanguageActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:background="@drawable/bg_trade_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLangNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_medium"
            android:includeFontPadding="true"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLangGloss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textAlignment="viewStart"
                android:textColor="@color/ink_soft"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLangPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_lang_tag"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/lang_phone_language"
                android:textColor="@color/gold_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/langRadio"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_lang_radio"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/ivLangTick"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_plain"
            android:visibility="invisible"
            app:tint="@color/white" />
    </FrameLayout>
</LinearLayout>
