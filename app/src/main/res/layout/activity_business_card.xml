<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/biz_card"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/biz_card_sub"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <!-- The same shop on a Status poster: new stock, Eid, closed today... -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenPoster"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/poster_title"
            app:icon="@drawable/ic_share" />

        <!-- Live preview of the card, redrawn on every keystroke -->
        <com.innovation313.roshankhata.ui.CardPreviewView
            android:id="@+id/ivCardPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/biz_card" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/biz_card_template"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

<!--
          Twenty-four designs, so the row scrolls rather than squeezing them onto
          one line. Filled in code, one chip per template, so adding a
          thirteenth is a line in CardTemplates and nothing here.
        -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/templateRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <EditText
            android:id="@+id/etBizName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/biz_card_name_hint"
            android:inputType="textCapWords"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/biz_card_type_hint"
            android:inputType="text"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/biz_card_owner_hint"
            android:inputType="textCapWords"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etPhone"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/biz_card_phone_hint"
            android:inputType="phone"
            android:minHeight="48dp"
            android:textSize="15sp" />


        <EditText
            android:id="@+id/etWhatsapp"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/biz_card_whatsapp_hint"
            android:inputType="phone"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <!-- Typed into the customer's WhatsApp when they scan the card's QR.
             Capped at 40 characters: a longer message makes a denser code. -->
        <EditText
            android:id="@+id/etQrMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/biz_card_qr_message_hint"
            android:inputType="textCapSentences"
            android:maxLength="40"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etEmail"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/biz_card_email_hint"
            android:inputType="textEmailAddress"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etWeb"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/biz_card_web_hint"
            android:inputType="textUri"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/biz_card_address_hint"
            android:inputType="textPostalAddress"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/biz_card_tagline_hint"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <!--
          The owner's card, the owner's call.
          Left on by default, because most shops will not think about it and
          the mark is small enough not to intrude. But a card sent as an
          inauguration announcement is the shop's own statement, and an owner
          who wants nothing else on it should not have to crop the image or
          look for another app to get that.
        -->
        <!-- The shop's logo from its Profile, placed by CardLogo in a free spot. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCardLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/biz_card_show_logo"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCardLogoHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/biz_card_logo_none"
            android:textColor="@color/brand_green_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCardWatermark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/biz_card_show_mark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/biz_card_note"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnShareCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:textAllCaps="false"
            android:text="@string/biz_card_share"
            android:textSize="16sp" />

        <!-- Print-ready PDF: 3.5 x 2 inch card with 0.125 inch bleed (see CardPdf). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCardPdf"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:textAllCaps="false"
            android:text="@string/biz_card_print_pdf"
            android:textColor="@color/brand_green_text"
            android:textSize="16sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/brand_green" />

    </LinearLayout>
</ScrollView>
