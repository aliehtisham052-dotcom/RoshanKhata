<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/biz_card"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/biz_card_sub"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <!-- No Poster button here (13 Oct): the card screen is for the card.
             Posters have their own tile on Home. -->

        <!-- Live preview of the card, redrawn on every keystroke -->
        <com.innovation313.roshankhata.ui.CardPreviewView
            android:id="@+id/ivCardPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/biz_card" />

        <!--
          The card's language (12 Oct): an Urdu card is wholly Urdu and reads
          right to left; an English one wholly English. Each keeps its own
          name, owner, address and lines; phone, WhatsApp, email and website
          are the same on both.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/biz_card_language"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- The card's nine languages (21 Oct), one pill each, in a row that scrolls. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/cardLangRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/biz_card_language_note"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/biz_card_template"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

<!--
          Twenty-four designs, so the row scrolls rather than squeezing them onto
          one line. Filled in code, one chip per template, so adding a
          thirteenth is a line in CardTemplates and nothing here.
        -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/templateRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- The card's details (13 Oct): what each language keeps for itself,
             then what both cards share. Labels and examples speak the CARD's
             language (BusinessCardActivity.applyCardLanguage), so an Urdu card
             is filled in wholly in Urdu and an English card in English. -->
        <LinearLayout
            android:id="@+id/cardOwnSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:textAlignment="viewStart"
                    android:id="@+id/tvCardOwnTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardOwnTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_business_current_chip"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/brand_green_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:textAlignment="viewStart"
                android:id="@+id/tvCardOwnSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/lblCardName"
                style="@style/CardFieldLabel" />

            <EditText
                android:id="@+id/etBizName"
                style="@style/EditorField"
                android:layout_marginTop="5dp"
                android:inputType="textCapWords" />

            <TextView
                android:id="@+id/lblCardType"
                style="@style/CardFieldLabel" />

            <EditText
                android:id="@+id/etType"
                style="@style/EditorField"
                android:layout_marginTop="5dp"
                android:inputType="textCapSentences" />

            <TextView
                android:id="@+id/lblCardOwner"
                style="@style/CardFieldLabel" />

            <EditText
                android:id="@+id/etOwner"
                style="@style/EditorField"
                android:layout_marginTop="5dp"
                android:inputType="textCapWords" />

            <TextView
                android:id="@+id/lblCardAddress"
                style="@style/CardFieldLabel" />

            <EditText
                android:id="@+id/etAddress"
                style="@style/EditorField"
                android:layout_marginTop="5dp"
                android:inputType="textPostalAddress|textCapSentences" />

            <TextView
                android:id="@+id/lblCardTagline"
                style="@style/CardFieldLabel" />

            <EditText
                android:id="@+id/etTagline"
                style="@style/EditorField"
                android:layout_marginTop="5dp"
                android:inputType="textCapSentences" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardSharedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:textAlignment="viewStart"
                android:id="@+id/tvCardSharedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblCardPhone"
                style="@style/CardFieldLabel" />

            <EditText
                android:id="@+id/etPhone"
                style="@style/EditorField"
                android:layout_marginTop="5dp"
                android:drawableStart="@drawable/ic_phone_small"
                android:textDirection="ltr"
                android:layoutDirection="ltr"
                android:textAlignment="viewStart"
                android:inputType="phone" />

            <!-- WhatsApp: the call number itself, or a number of its own. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblCardWhatsapp"
                    style="@style/CardFieldLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchWhatsappSame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etWhatsapp"
                style="@style/EditorField"
                android:layout_marginTop="2dp"
                android:drawableStart="@drawable/ic_action_whatsapp"
                android:inputType="phone"
                android:layoutDirection="ltr"
                android:textAlignment="viewStart"
                android:textDirection="ltr" />

            <TextView
                android:id="@+id/lblCardEmail"
                style="@style/CardFieldLabel" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/EditorField"
                android:layout_marginTop="5dp"
                android:drawableStart="@drawable/ic_mail_line"
                android:textDirection="ltr"
                android:layoutDirection="ltr"
                android:textAlignment="viewStart"
                android:inputType="textEmailAddress" />

            <TextView
                android:id="@+id/lblCardWeb"
                style="@style/CardFieldLabel" />

            <EditText
                android:id="@+id/etWeb"
                style="@style/EditorField"
                android:layout_marginTop="5dp"
                android:drawableStart="@drawable/ic_globe_line"
                android:textDirection="ltr"
                android:layoutDirection="ltr"
                android:textAlignment="viewStart"
                android:inputType="textUri" />

            <!-- Typed into the customer's WhatsApp when they scan the card's QR.
                 Capped at 40 characters: a longer message makes a denser code. -->
            <TextView
                android:id="@+id/lblCardQr"
                style="@style/CardFieldLabel" />

            <EditText
                android:id="@+id/etQrMessage"
                style="@style/EditorField"
                android:layout_marginTop="5dp"
                android:maxLength="40"
                android:inputType="textCapSentences" />
        </LinearLayout>

        <!-- The shop's logo from its Profile, placed by CardLogo in a free spot. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCardLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/biz_card_show_logo"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCardLogoHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/biz_card_logo_none"
            android:textColor="@color/brand_green_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCardWatermark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/biz_card_show_mark"
            android:textSize="14sp" />

        <!-- One action (13 Oct): the card goes out as a picture. The print-shop
             PDF is gone from this screen; the owner wants the card kept simple. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/biz_card_send_picture"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/biz_card_note"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
