<?xml version="1.0" encoding="utf-8"?>
<!--
  Hudhud's voice (13-14 Nov 2026, ui/HudhudVoiceSheet; the owner: "do teen qism ki awaaz… professionally", "cartoonish,
  interacting awaaz"): what he calls the owner, how he speaks (five styles as chips, the pace on a slider), which of the
  phone's own voices, how he says his name and Alhamdulillah (each heard when chosen), his little bird calls, a sample,
  how he listens, and the testing tools folded away. A stack, one control a row (lesson 58: a 360 dp phone at 150% text
  in the long languages); the choices are chips, which wrap onto as many lines as their words need.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_grabber" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHudVoiceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hudhud_voice_title"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnHudVoiceClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:scaleType="center"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hudhud_voice_help"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <!-- What he calls the owner. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hudhud_call_me"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHudCallMe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hudhud_field"
            android:hint="@string/hudhud_call_me_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="30"
            android:maxLines="1"
            android:minHeight="52dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <!-- How he speaks: Professional (the phone's voice as it is), Gentle, Lively, Serious, Cartoon. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hudhud_style"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgHudStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <!-- His pace, a step of a tenth between slow and quick; heard when the finger lifts. The mark is the night-aware
             green, never the fill green (lesson 60). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hudhud_pace"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHudPaceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_muted"
                android:textDirection="ltr"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/slHudPace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/hudhud_pace"
            android:stepSize="0.1"
            android:valueFrom="0.6"
            android:valueTo="1.5"
            app:haloColor="@color/hairline"
            app:thumbColor="@color/brand_green_text"
            app:tickVisible="false"
            app:trackColorActive="@color/brand_green_text"
            app:trackColorInactive="@color/hairline" />

        <!-- Which of the phone's own voices. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hudhud_voice_choice"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgHudVoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/tvHudNoVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/hudhud_voice_none_here"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHudMoreVoices"
            style="@style/BackupOutlineButton"
            android:layout_marginTop="10dp"
            android:text="@string/hudhud_voice_more" />

        <!-- How he says his own name (13 Nov 2026, the owner: "apna naam bhi sahi tarah nahi bolta"): the ways his
             name can be written for the voice, each heard when chosen (HudhudSay.nameWays). Shown once the phone has a
             voice to hear them in, and only for a language that has more than one way. -->
        <LinearLayout
            android:id="@+id/llHudName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/hudhud_name_say"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/hudhud_name_say_help"
                android:textAlignment="viewStart"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgHudNameWay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
        </LinearLayout>

        <!-- How he says Alhamdulillah (14 Nov 2026, the owner: the phone's voice read it wrongly): shown only for a
             language that has more than one way (HudhudPronounce.ways); each is heard in a sentence when chosen. -->
        <LinearLayout
            android:id="@+id/llHudPron"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/hudhud_pron_say"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/hudhud_pron_help"
                android:textAlignment="viewStart"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgHudPronWay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
        </LinearLayout>

        <!-- His little bird calls (14 Nov 2026): a trill before he speaks, a call when he starts listening, a bright
             one before good news. On by themselves with the Cartoon style; the switch is the owner's last word. A tap
             on a chip plays that call whether the switch is on or not. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hudhud_chirps_title"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swHudChirps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp"
            android:text="@string/hudhud_chirps_switch"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgHudCalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHudSample"
            style="@style/BackupPrimaryButton"
            android:layout_marginTop="18dp"
            android:text="@string/hudhud_voice_try"
            app:icon="@drawable/ic_volume_on" />

        <!-- How he listens. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/hudhud_listen_title"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHudListen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHudListen"
            style="@style/BackupOutlineButton"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- The testing tools, folded away (14 Nov 2026): the owner's check of a test build (HudhudCheck) — right or
             wrong under every answer, the counts, the list shared or cleared. Off by default; kept on this phone only. -->
        <LinearLayout
            android:id="@+id/rowHudTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHudToolsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hudhud_tools_title"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivHudToolsChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llHudTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/hudhud_check_title"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swHudCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:text="@string/hudhud_check_switch"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHudCheckCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:textAlignment="viewStart"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHudCheckShare"
                    style="@style/BackupOutlineButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hudhud_check_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHudCheckClear"
                    style="@style/BackupOutlineButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/hudhud_check_clear" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
