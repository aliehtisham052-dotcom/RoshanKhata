<?xml version="1.0" encoding="utf-8"?>
<!--
  Hudhud's voice (13 Nov 2026, ui/HudhudVoiceSheet; the owner: "do teen qism ki awaaz… professionally"): what he calls
  the owner, how he speaks (three styles), which of the phone's own voices, a sample to hear, the phone's voice
  downloads, and how he listens. Everything is a stack, one control a row (lesson 58: a 360 dp phone at 150% text in
  the long languages); the choices are radio rows, which grow with their words.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_grabber" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHudVoiceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hudhud_voice_title"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnHudVoiceClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:scaleType="center"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hudhud_voice_help"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <!-- What he calls the owner. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hudhud_call_me"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHudCallMe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hudhud_field"
            android:hint="@string/hudhud_call_me_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="30"
            android:maxLines="1"
            android:minHeight="52dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <!-- How he speaks. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hudhud_style"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgHudStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <!-- The phone's own voice as it is: his first style (13 Nov 2026, the owner: "professional sound"). -->
            <RadioButton
                android:id="@+id/rbHudProfessional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hudhud_style_professional"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbHudGentle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hudhud_style_gentle"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbHudLively"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hudhud_style_lively"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbHudSerious"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hudhud_style_serious"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- Which of the phone's own voices. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hudhud_voice_choice"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgHudVoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvHudNoVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/hudhud_voice_none_here"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- How he says his own name (13 Nov 2026, the owner: "apna naam bhi sahi tarah nahi bolta"): the ways his
             name can be written for the voice, each heard when chosen (HudhudSay.nameWays). -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hudhud_name_say"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/hudhud_name_say_help"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgHudNameWay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHudMoreVoices"
            style="@style/BackupOutlineButton"
            android:layout_marginTop="10dp"
            android:text="@string/hudhud_voice_more" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHudSample"
            style="@style/BackupPrimaryButton"
            android:layout_marginTop="12dp"
            android:text="@string/hudhud_voice_try"
            app:icon="@drawable/ic_volume_on" />

        <!-- How he listens. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/hudhud_listen_title"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHudListen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHudListen"
            style="@style/BackupOutlineButton"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- The owner's check of a test build (14 Nov 2026, HudhudCheck): right or wrong under every answer, the
             counts here, the list shared or cleared. Off by default; kept on this phone only. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/hudhud_check_title"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swHudCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp"
            android:text="@string/hudhud_check_switch"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvHudCheckCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHudCheckShare"
                style="@style/BackupOutlineButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hudhud_check_share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHudCheckClear"
                style="@style/BackupOutlineButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/hudhud_check_clear" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
