<?xml version="1.0" encoding="utf-8"?>
<!--
  One banner of the Home slider (7 Oct): a full-colour poster in the
  feature's own hue — its illustration on a white tile over two faint discs
  at the start, a two-line headline and a white pill button at the end. The
  whole banner opens the feature. No photographs of people anywhere.

  At a large text size (7 Oct) the headline shrinks to fit its two lines
  (auto-size, 12.5sp down to 9sp) rather than being cut with "…", and the
  pill is capped so it cannot push the words off the banner.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp">

    <LinearLayout
        android:id="@+id/slideRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_banner_blue"
        android:clipToOutline="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Compact (7 Oct): 68dp tall, the owner's call; the big poster was taking the screen. -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="match_parent">

            <View
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:layout_marginStart="-30dp"
                android:background="@drawable/bg_banner_disc" />

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_banner_tile"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/ivSlideIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvSlideSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingEnd="8dp"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="12.5sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            tools:text="What comes in and goes out over the next 30 days" />

        <!-- The label's colour is set in code to the feature's DAY tone (the
             pill is white in both modes). The literal below is fi_blue_b's
             day value, so the static dark-mode check sees the face the phone
             does; a @color here was repainted light at night by that check. -->
        <TextView
            android:id="@+id/tvSlideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_banner_cta"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="132dp"
            android:paddingStart="11dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:textColor="#185FA5"
            android:textSize="11sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            tools:text="Cash flow  →" />
    </LinearLayout>
</FrameLayout>
