<?xml version="1.0" encoding="utf-8"?>
<!--
  Business Profile (redesigned 30 Sep 2026 from the owner's approved mockup).

  Order follows how professional invoicing apps lay out a company profile
  (identity first, then how you get paid, then seals, then document options):
  Identity -> Getting paid -> Stamp & signature -> Invoice & statement.

  Every text box is a Material TextInputLayout, so its label moves up and
  STAYS once text is typed. The old plain EditText showed its name only as a
  hint, which vanished on typing — four filled bank boxes read "gggg / vgg /
  bvbb / 999" with nothing to say which was the IBAN.

  Save sits in a bar pinned below the scroll, with an "unsaved changes" line
  that appears only when something differs from what is stored.

  Every id the activity reads is kept.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Header ===== -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="46dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/business_profile"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/business_settings_subtitle"
                    android:textColor="@color/header_on_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ===== Live preview: the invoice header as it will print ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_profile_card"
                android:elevation="3dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_business_logo">

                        <TextView
                            android:id="@+id/tvPreviewInitials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/gold_on_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivPreviewLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/bp_logo"
                            android:padding="3dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPreviewBusinessName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/app_name"
                            android:textColor="@color/brand_green_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_preview_thumb_slot">

                        <ImageView
                            android:id="@+id/ivPreviewStampThumb"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/stamp"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/tvPreviewStampPlaceholder"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:alpha="0.35"
                            android:contentDescription="@string/stamp"
                            android:src="@drawable/ic_seal_stamp"
                            app:tint="@color/text_muted" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_preview_thumb_slot">

                        <ImageView
                            android:id="@+id/ivPreviewQrThumb"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/payment_qr"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/tvPreviewQrPlaceholder"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:alpha="0.35"
                            android:contentDescription="@string/payment_qr"
                            android:src="@drawable/ic_qr_scan"
                            app:tint="@color/text_muted" />
                    </FrameLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hairline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/profile_preview_caption"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== Identity ===== -->
            <TextView
                style="@style/ProfileSectionLabel"
                android:text="@string/bp_section_identity" />

            <LinearLayout style="@style/ProfileCard">

                <!-- Shop logo: optional; the invoice tile falls back to the
                     app's mark and the stock register to the initials. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_preview_thumb_slot">

                        <ImageView
                            android:id="@+id/ivLogoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/bp_logo"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/ivNoLogo"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:contentDescription="@string/bp_logo"
                            android:src="@drawable/ic_image"
                            app:tint="@color/text_muted" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bp_logo"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/bp_logo_help"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickLogo"
                        style="@style/ProfileSmallButton"
                        android:text="@string/bp_add" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemoveLogo"
                        style="@style/ProfileRemoveButton"
                        android:contentDescription="@string/bp_remove_logo"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileField"
                    android:hint="@string/business_name"
                    app:placeholderText="@string/business_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBusinessName"
                        style="@style/ProfileFieldInput"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileField"
                    android:hint="@string/business_address"
                    app:placeholderText="@string/business_address_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBusinessAddress"
                        style="@style/ProfileFieldInput"
                        android:inputType="textPostalAddress|textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileField"
                    android:hint="@string/bp_phone"
                    app:helperText="@string/bp_phone_help"
                    app:placeholderText="@string/bp_phone_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBusinessPhone"
                        style="@style/ProfileFieldInput"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileField"
                    android:hint="@string/bp_strn"
                    app:helperText="@string/bp_strn_help"
                    app:placeholderText="@string/invoice_strn_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStrn"
                        style="@style/ProfileFieldInput"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Trade / shoba (4 Oct 2026): which kind of shop keeps this book -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bp_trade"
                            android:textAppearance="?attr/textAppearanceSubtitle2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bp_trade_help"
                            android:textAppearance="?attr/textAppearanceCaption" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrade"
                        style="@style/ProfileSmallButton" />
                </LinearLayout>

                <!-- Currency sign (4 Oct 2026): a choice, so a button, not a text field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bp_currency"
                            android:textAppearance="?attr/textAppearanceSubtitle2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bp_currency_help"
                            android:textAppearance="?attr/textAppearanceCaption" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCurrency"
                        style="@style/ProfileSmallButton" />
                </LinearLayout>

                <!-- Calendar (5 Oct): how dates print; what is saved never changes. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bp_calendar"
                            android:textAppearance="?attr/textAppearanceSubtitle2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bp_calendar_help"
                            android:textAppearance="?attr/textAppearanceCaption" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalendar"
                        style="@style/ProfileSmallButton" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Getting paid ===== -->
            <TextView
                style="@style/ProfileSectionLabel"
                android:text="@string/bp_section_paid" />

            <LinearLayout style="@style/ProfileCard">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bp_paid_help"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileField"
                    android:hint="@string/invoice_bank_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBankName"
                        style="@style/ProfileFieldInput"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileField"
                    android:hint="@string/invoice_bank_title_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBankTitle"
                        style="@style/ProfileFieldInput"
                        android:inputType="textPersonName|textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBankIban"
                    style="@style/ProfileField"
                    android:hint="@string/invoice_bank_iban_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBankIban"
                        style="@style/ProfileFieldInput"
                        android:inputType="textCapCharacters|textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBankJazzCash"
                    style="@style/ProfileField"
                    android:hint="@string/invoice_bank_jazzcash_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBankJazzCash"
                        style="@style/ProfileFieldInput"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/hairline" />

                <!-- Payment QR: one compact row. The long warning now appears
                     where it is read — in the confirm dialog right after a QR
                     is chosen (qr_confirm_message) — not as a paragraph on
                     every visit. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_preview_thumb_slot">

                        <ImageView
                            android:id="@+id/ivQrPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/payment_qr"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/tvNoQr"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:contentDescription="@string/no_qr_yet"
                            android:src="@drawable/ic_qr_scan"
                            app:tint="@color/text_muted" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bp_qr"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/bp_qr_help"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickQr"
                        style="@style/ProfileSmallButton"
                        android:text="@string/bp_add" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemoveQr"
                        style="@style/ProfileRemoveButton"
                        android:contentDescription="@string/remove_qr"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Stamp & signature ===== -->
            <TextView
                style="@style/ProfileSectionLabel"
                android:text="@string/bp_section_seals" />

            <LinearLayout style="@style/ProfileCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/ProfileTile"
                        android:layout_marginEnd="6dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="96dp"
                            android:background="@drawable/bg_preview_thumb_slot">

                            <ImageView
                                android:id="@+id/ivStampPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/stamp"
                                android:padding="6dp"
                                android:scaleType="fitCenter"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/tvNoStamp"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:alpha="0.4"
                                android:contentDescription="@string/no_stamp_yet"
                                android:src="@drawable/ic_seal_stamp"
                                app:tint="@color/text_muted" />
                        </FrameLayout>

                        <TextView
                            style="@style/ProfileTileTitle"
                            android:text="@string/stamp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickStamp"
                                style="@style/ProfileTileButton"
                                android:text="@string/bp_add" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRemoveStamp"
                                style="@style/ProfileRemoveButton"
                                android:contentDescription="@string/remove_stamp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        style="@style/ProfileTile"
                        android:layout_marginStart="6dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="96dp"
                            android:background="@drawable/bg_preview_thumb_slot">

                            <ImageView
                                android:id="@+id/ivSignaturePreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/signature"
                                android:padding="6dp"
                                android:scaleType="fitCenter"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/tvNoSignature"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:alpha="0.4"
                                android:contentDescription="@string/no_signature_yet"
                                android:src="@drawable/ic_signature_pen"
                                app:tint="@color/text_muted" />
                        </FrameLayout>

                        <TextView
                            style="@style/ProfileTileTitle"
                            android:text="@string/signature" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickSignature"
                                style="@style/ProfileTileButton"
                                android:text="@string/bp_add" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRemoveSignature"
                                style="@style/ProfileRemoveButton"
                                android:contentDescription="@string/remove_signature"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/bp_seals_help"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== Invoice & statement ===== -->
            <TextView
                style="@style/ProfileSectionLabel"
                android:text="@string/bp_section_docs" />

            <LinearLayout
                style="@style/ProfileCard"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ProfileField"
                    android:layout_marginTop="4dp"
                    android:hint="@string/invoice_terms"
                    app:helperText="@string/bp_terms_help"
                    app:placeholderText="@string/invoice_terms_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInvoiceTerms"
                        style="@style/ProfileFieldInput"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/swPhotoOnStatement"
                            android:text="@string/bp_photo"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/bp_photo_help"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swPhotoOnStatement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/bp_photo"
                        android:minHeight="48dp" />
                </LinearLayout>

                <!-- WhatsApp: the after-entry offer and payment details on reminders (2 Oct). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/swAskShare"
                            android:text="@string/bp_ask_share"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/bp_ask_share_help"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAskShare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/bp_ask_share"
                        android:minHeight="48dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/swPayOnReminder"
                            android:text="@string/bp_pay_reminder"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/bp_pay_reminder_help"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swPayOnReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/bp_pay_reminder"
                        android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== Save, pinned below the scroll ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvUnsaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:drawablePadding="6dp"
            android:text="@string/bp_unsaved"
            android:textColor="@color/gold_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/save"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/header_grad_mid"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
