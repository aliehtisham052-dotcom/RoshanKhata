<?xml version="1.0" encoding="utf-8"?>
<!--
  Home. The net balance stays at the top, because that is the number the owner
  opens the app to see. Everything the app can do sits below it as a grid of
  cards, each one leading to its own screen.

  The features used to live behind a More menu, which in practice meant most
  shopkeepers never found out the app had a Zakat calculator or a bills book
  at all. A feature nobody can find may as well not have been built.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <!--
      Home header (redesigned 23 Sep): diagonal brand green with a gold rule
      and two faint gold arcs (bg_home_header), the logo beside the name,
      and the two summary cards as gold-edged glass with a small coloured
      arrow chip — red for what comes in, green for what goes out — instead
      of the pale pink and mint boxes, which sat outside the app's green-and-
      gold language. Ids are unchanged; MainActivity only sets their text.
    -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_logo_tile"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_on_green" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:letterSpacing="0.04"
                    android:text="@string/app_tagline"
                    android:textColor="@color/gold_on_dark"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.1"
            android:text="@string/net_balance"
            android:textAllCaps="true"
            android:textColor="@color/gold_on_dark"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Tappable: the eye says this can be hidden without anyone explaining it. -->
        <LinearLayout
            android:id="@+id/balanceRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tvNetBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs 0"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivEye"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_home_eye"
                android:contentDescription="@string/hide_balance"
                android:padding="7dp"
                android:src="@drawable/ic_eye_open"
                app:tint="@color/white" />
        </LinearLayout>

        <!--
          The two halves of that net figure, the way a shopkeeper thinks: what
          is owed TO them, and what they owe OUT.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/homeCardGet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_summary"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_home_chip_get"
                        android:importantForAccessibility="no"
                        android:padding="4dp"
                        android:src="@drawable/ic_arrow_got"
                        app:tint="@color/bal_owed_to_me" />

                    <TextView
                        android:id="@+id/tvTotalGet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Rs 7,520" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/i_have_to_get"
                    android:textColor="@color/header_on_dark"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeCardGive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_summary"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_home_chip_give"
                        android:importantForAccessibility="no"
                        android:padding="4dp"
                        android:src="@drawable/ic_arrow_gave"
                        app:tint="@color/bal_i_owe" />

                    <TextView
                        android:id="@+id/tvTotalGive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Rs 167,665" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/i_have_to_give"
                    android:textColor="@color/header_on_dark"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      Every feature, in the open. Scrolls, so the grid can grow without the
      last row falling off a short screen.
    -->
    <!--
      Every feature, in the open. Scrolls, so the grid can grow without the
      last row falling off a short screen.

      The rows are built in code rather than <include>d twelve times over:
      an <include> keeps the ids of the layout it pulls in, so all twelve
      copies shared one ivFeatureIcon and one tvFeatureLabel. Looking those
      up per card returned the first copy every time, and the icon lookup
      came back null on every card but the first.
    -->
    <ScrollView
        android:id="@+id/featureScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.12"
                android:text="@string/home_section_daily"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/gridDaily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.12"
                android:text="@string/home_section_business"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/gridBusiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!--
              Room beneath the last row so the walkthrough can scroll it to the
              top of the viewport. Without this the final tiles could never
              rise far enough for their card to sit below them.
            -->
            <Space
                android:id="@+id/gridTailSpace"
                android:layout_width="match_parent"
                android:layout_height="0dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/nav_item_colour"
        app:itemTextColor="@color/nav_item_colour"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_home_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
