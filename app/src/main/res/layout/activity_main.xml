<?xml version="1.0" encoding="utf-8"?>
<!--
  Home. The net balance stays at the top, because that is the number the owner
  opens the app to see. Everything the app can do sits below it as a grid of
  cards, each one leading to its own screen.

  The features used to live behind a More menu, which in practice meant most
  shopkeepers never found out the app had a Zakat calculator or a bills book
  at all. A feature nobody can find may as well not have been built.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <!--
      Home header (redesigned 23 Sep, restyled 7 Oct, shortened the same
      day): diagonal brand green with a gold rule and three gold rings
      (bg_home_header); one row of menu, logo, the shop's name, bell and ⋮;
      then one frosted strip with the net balance and the backup's state.
      It was 37% of the screen with a tagline, a tall balance card, two
      summary cards and a status line; the owner wanted the features to
      have the screen. The two summary cards live on the Khata screen.
    -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_light"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnDrawer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_title"
                android:src="@drawable/ic_menu_lines"
                app:tint="@color/header_light_ink" />

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_logo_tile"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_on_green" />
            </FrameLayout>

            <!--
              The shop's own name as the title (7 Oct, the owner's call): the
              screen is about their shop, and the app's name is on the logo
              beside it, in the drawer and in About. One line, so the header
              stays short. Tap: the business switcher.
            -->
            <TextView
                android:id="@+id/tvHomeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/home_switch_business"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/app_name"
                android:textColor="@color/header_light_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- The bell (6 Oct): today's alerts, counted on the phone. -->
            <FrameLayout
                android:id="@+id/btnAlerts"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/na_title">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/header_light_ink" />

                <TextView
                    android:id="@+id/tvAlertBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- The ⋮ menu (7 Oct): every setting and door the old More sheet held. -->
            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_title"
                android:src="@drawable/ic_feature_settings"
                app:tint="@color/header_light_ink" />
        </LinearLayout>

        <!--
          The net balance on one short strip (7 Oct): the figure and the
          eye on the left, the backup's state on the right. The two halves
          (to get / to give) left this header the same day — they are the
          Khata screen's first line, where the list they summarise is — so
          Home's header is a title row and this strip, and the features get
          the screen. Ids balanceRow / tvNetBalance / ivEye are unchanged.

          Hidden by default (the owner's call): the figure shows as dots
          until the eye is tapped, so a customer at the counter sees nothing.
        -->
        <!-- Two boxes, not one (7 Oct, the owner's call): the balance and the backup are different things. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tappable: the eye says this can be hidden without anyone explaining it. -->
            <LinearLayout
                android:id="@+id/balanceRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_home_balance_card"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/net_balance"
                    android:textAllCaps="true"
                    android:textColor="@color/gold_on_dark"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNetBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="Rs 0"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivEye"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_home_eye"
                        android:contentDescription="@string/hide_balance"
                        android:padding="6dp"
                        android:src="@drawable/ic_eye_closed"
                        app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- When the books were last backed up (tap: Backup). The only
                 place the words appear; the Khata screen shows a dot. -->
            <LinearLayout
                android:id="@+id/homeBackupTap"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_backup_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_feature_backup"
                    app:tint="@color/backup_ink" />

                <TextView
                    android:id="@+id/tvHomeBackupAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:maxWidth="84dp"
                    android:textColor="@color/backup_ink"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="Backed up 10:42" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      Every feature, in the open. Scrolls, so the grid can grow without the
      last row falling off a short screen.
    -->
    <!--
      Every feature, in the open. Scrolls, so the grid can grow without the
      last row falling off a short screen.

      The rows are built in code rather than <include>d twelve times over:
      an <include> keeps the ids of the layout it pulls in, so all twelve
      copies shared one ivFeatureIcon and one tvFeatureLabel. Looking those
      up per card returned the first copy every time, and the icon lookup
      came back null on every card but the first.
    -->
    <ScrollView
        android:id="@+id/featureScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp">

            <!--
              Read-only phone (3 Oct): whose copy this is and how old, one
              tap to refresh. Same look as the late note below it. Gone on
              every normal phone.
            -->
            <TextView
                android:id="@+id/tvHomeViewer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_home_late"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="@color/note_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!--
              "N customers are paying later than usual" (1 Oct): counted from
              each customer's own payment habit (PaymentHabit), the same rule
              as the Follow-up screen it opens. Gone when nobody is late.
            -->
            <TextView
                android:id="@+id/tvHomeLate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_home_late"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="@color/note_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- The feature slider (6 Oct): four cards that turn on their own; HomeSlides. -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/homeSlides"
                android:layout_width="match_parent"
                android:layout_height="68dp" />

            <!-- Four small dots under the banner (7 Oct): the owner wanted to see how many there are. -->
            <LinearLayout
                android:id="@+id/homeSlideDots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!--
              Today (7 Oct): the bell's items as chips on one line — "Cheques · 2",
              "Late · 1", "Bills · 1" — so the day's work is in view without a
              tap. Tap: Notifications. Gone when there is nothing today.
            -->
            <HorizontalScrollView
                android:id="@+id/todayStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_today_strip"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/todayChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:letterSpacing="0.1"
                        android:text="@string/home_today"
                        android:textAllCaps="true"
                        android:textColor="@color/brand_green_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>


            <!-- Section headings (7 Oct): bold ink, not spaced grey caps; Business carries "See all" (the drawer). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:text="@string/home_sec_daily"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/gridDaily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/home_sec_business"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/home_see_all"
                    android:textColor="@color/brand_green_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gridBusiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/home_section_tools"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/gridTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- A quiet last line: the app, its version, the brand. -->
            <TextView
                android:id="@+id/tvHomeFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/text_faint"
                android:textSize="10sp"
                tools:text="Roshan Khata 1.9 · Innovation-313" />

            <!--
              Room beneath the last row so the walkthrough can scroll it to the
              top of the viewport. Without this the final tiles could never
              rise far enough for their card to sit below them.
            -->
            <Space
                android:id="@+id/gridTailSpace"
                android:layout_width="match_parent"
                android:layout_height="0dp" />
        </LinearLayout>
    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- The three-line menu (6 Oct): built in HomeDrawer from the same feature list as the grid. -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_home_logo_tile"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_on_green" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="@color/gold_on_dark"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!--
          The open business (7 Oct): a card the way an account switcher shows
          the signed-in account — store tile, the shop's name, "Active
          business · 2 of 3" under it, a chevron at the end. The whole card
          opens the switcher; no "Switch" word anywhere.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_green"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/drawerBusinessTap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_drawer_business"
                android:contentDescription="@string/home_switch_business"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="9dp"
                android:paddingEnd="8dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_ledger_store"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/ic_storefront"
                    app:tint="@color/brand_green_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerBusiness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Bhatti Traders" />

                    <TextView
                        android:id="@+id/tvDrawerBusinessSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/header_on_dark"
                        android:textSize="11sp"
                        tools:text="Active business · 2 of 3" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/gold_on_dark" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/drawerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>

