<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--
          The business's own name and picture, tappable to change it — a shop
          with several businesses switches between them here. The name comes
          from the saved Business Profile; until one is set it falls back to
          the app name so the header is never blank. The gear opens the app's
          settings (the same "More" menu), because notifications and settings
          belong to the whole app, not to this one ledger.
        -->
        <LinearLayout
            android:id="@+id/businessHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBusinessLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_business_logo"
                android:contentDescription="@string/business_name"
                android:padding="9dp"
                android:src="@drawable/ic_storefront"
                app:tint="@color/gold_on_dark" />

            <!--
              The name is tappable again — and this time the tap has a job of
              its own. When it last was, it merely duplicated the profile icon
              two thumbs to its right, and it was retired for that (de0e13d).
              Multi-business is the day it was retired FOR: the tap now opens
              the switcher — choosing which shop is open — which is not the
              same act as editing a shop, and belongs on the shop's own name
              the way editing belongs on the profile icon.
            -->
            <LinearLayout
                android:id="@+id/businessNameTap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBusinessName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tap_to_change_business"
                    android:textColor="@color/header_on_dark"
                    android:textSize="10sp" />
            </LinearLayout>

            <!--
              Backup status, as an icon the owner asked for (like the
              competitor's): tap it to open the Backup screen, which shows the
              time of the last backup. The "Backup due" text used to sit on the
              summary line below; it reads better as this quiet header icon.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHeaderBackup"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/backup_now"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_feature_backup"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHeaderSettings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/business_profile"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_profile_card"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark" />
        </LinearLayout>

        <!--
          The net balance: its label and its figure share one line now. Two
          stacked lines read grander, but the grandeur was costing the list a
          row of customers — and the one number the owner opens the app for is
          still the largest thing on the band. Tappable; the eye says it hides.
        -->
        <LinearLayout
            android:id="@+id/balanceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/net_balance"
                android:textColor="@color/header_on_dark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNetBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs 0"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivEye"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/hide_balance"
                android:src="@drawable/ic_eye_open"
                app:tint="@color/header_on_dark" />

            <!--
              The backup age lives here, beside the money it protects.

              It went on the customer-count line first and wrapped to a second
              row on a real phone, which put back height the header had just
              given up. Measured afterwards, which was the wrong order: that
              line has about 142dp beside the sort and export buttons — some
              25 characters at 11sp — and nothing useful fits. This row ends
              after the balance and has the space free.
            -->
            <TextView
                android:id="@+id/tvBackupAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/header_on_dark"
                android:textSize="10sp" />
        </LinearLayout>

        <!--
          Three boxes below the net figure, the way a shopkeeper actually
          thinks: one total for everything owed TO them (money to collect,
          red), one for everything they owe OUT (green), and — the owner
          asked for this third one specifically — a count of accounts sitting
          at exactly zero, which the other two boxes have never been able to
          show since a settled account is neither owed nor owing. The net
          line above is the single summary; these three break it into the
          groups the owner actually filters by.
        -->
        <!--
          Two boxes now, not three. Everything owed TO the owner (collect, red)
          and everything owed OUT (green). The settled count used to sit here as
          a third box, but the owner moved it down to the summary line beside
          the backup status, where a plain count belongs — the two boxes up here
          are the ones actually tapped to filter.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/boxTotalGet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_summary_get"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp">

                <TextView
                    android:id="@+id/tvTotalGet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bal_owed_to_me"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Rs 7,520" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/i_have_to_get"
                    android:textColor="@color/bal_owed_to_me"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxTotalGive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_summary_give"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp">

                <TextView
                    android:id="@+id/tvTotalGive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bal_i_owe"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Rs 167,665" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/i_have_to_give"
                    android:textColor="@color/bal_i_owe"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
              A plain search box. Typing narrows the list below; there is no
              dropdown floating over it.
            -->
            <EditText
                android:id="@+id/etSearchParties"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:hint="@string/search_parties"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:completionThreshold="1"
                android:dropDownVerticalOffset="4dp"
                android:popupBackground="@color/white"
                android:textColor="@color/ink"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <!--
              Speak an entry instead of typing it. Beside the search box
              because both are ways of saying who you mean, and because a
              shopkeeper with a sack in one hand has neither hand for a
              keypad.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceEntry"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="50dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/voice_entry"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="26dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark" />

            <!--
              Open the filter sheet: Account (all / clear / to-get / to-give)
              and Type (all / customers / suppliers) together in one place,
              the way the owner asked, instead of three loose buttons across
              the header. Beside the mic because it acts on the same list.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenFilter"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="50dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/filter_title"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_filter_sliders"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="26dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark" />
        </LinearLayout>

        <!--
          The line under the search row: on the left, how many accounts there
          are, how many are settled, and whether a backup is due; on the right,
          the everyday actions the owner reaches for on the whole list — sort
          the order, share a PDF, scan a customer's QR card. These were loose
          buttons in the header before; grouped here they read as one toolbar
          and free the search row to be just search.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPartySummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/header_on_dark"
                android:textSize="11sp"
                tools:text="1163 customers · 12 settled · Backup due" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortParties"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/sort"
                android:textColor="@color/header_on_dark"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/header_on_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLedgerPdf"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="50dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/ledger_pdf_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_pdf_doc"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="26dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="50dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/scan_customer_qr"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_qr_scan"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="26dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark" />
        </LinearLayout>

        <!--
          What the microphone understood, answered in place.

          This was a full dialog: a title, three lines of message and two
          spread buttons, covering the list it was talking about. It is one
          strip now, directly under the mic that produced it — the owner reads
          a line, and either opens the entry or dismisses it. Nothing is saved
          from here either way; Open Entry still lands on the party's screen
          where the credit-limit warning and every other check run.
        -->
        <LinearLayout
            android:id="@+id/voiceStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_voice_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVoiceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Bilal  ·  Rs 5,000  ·  I Gave" />

                <TextView
                    android:id="@+id/tvVoiceHeard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    tools:text="Heard: bilal ko paanch hazaar diye" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceOpen"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/voice_open_entry"
                android:textColor="@color/brand_green"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceDismiss"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/cancel"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_muted" />
        </LinearLayout>

    </LinearLayout>

    <!--
      The main sections, out in the open. They were buried in an overflow menu
      before, which in practice meant most shopkeepers would never have
      discovered that a Cashbook or a Cheque register existed at all.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/nav_item_colour"
        app:itemTextColor="@color/nav_item_colour"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_home_nav" />

    <!--
      The selection bar, shown only while customers are being picked.
      
      It sits between the header and the list rather than replacing the
      header, so the balances stay in view the whole time — a shopkeeper
      about to remove a batch of customers should be able to see what the
      shop is owed while they do it.

      Gone by default. Constrained so the list starts below it, which in a
      ConstraintLayout means the list simply starts at the header when the
      bar is not there.
    -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/section_khata"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectAll"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_all"
            android:textColor="@color/gold_on_dark"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteSelected"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:textColor="@color/red_gave_on_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvParties"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selectionBar" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/no_parties_yet"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvParties"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvParties" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddParty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/add_party"
        android:textColor="@color/white"
        app:backgroundTint="@color/ink"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
