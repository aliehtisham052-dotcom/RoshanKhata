<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!--
          One tagline, not two. The brand line beneath it was carrying the same
          words, so the phrase printed twice. It now says the brand.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/app_tagline"
            android:textColor="@color/header_on_dark"
            android:textSize="12sp" />

        <!--
          The net balance is the one number the owner opens the app to see.
          It gets the room to say so, and nothing sits between it and the eye.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/net_balance"
            android:textColor="@color/header_on_dark"
            android:textSize="12sp" />

        <!--
          Tappable. The eye tells the owner this can be hidden without anyone
          having to explain it to them.
        -->
        <LinearLayout
            android:id="@+id/balanceRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tvNetBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs 0"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivEye"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/hide_balance"
                android:src="@drawable/ic_eye_open"
                app:tint="@color/header_on_dark" />
        </LinearLayout>

        <!--
          Two boxes below the net figure, the way a shopkeeper actually thinks:
          one total for everything owed TO them (money to collect, red), one for
          everything they owe OUT (green). The net line above is the single
          summary; these two break it into the parts the owner chases and pays.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/boxTotalGet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_summary_get"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTotalGet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bal_owed_to_me"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Rs 7,520" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/i_have_to_get"
                    android:textColor="@color/bal_owed_to_me"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxTotalGive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_summary_give"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTotalGive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bal_i_owe"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Rs 167,665" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/i_have_to_give"
                    android:textColor="@color/bal_i_owe"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
              A plain search box. Typing narrows the list below; there is no
              dropdown floating over it.
            -->
            <EditText
                android:id="@+id/etSearchParties"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:hint="@string/search_parties"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:completionThreshold="1"
                android:dropDownVerticalOffset="4dp"
                android:popupBackground="@color/white"
                android:textColor="@color/ink"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <!--
              Speak an entry instead of typing it. Beside the search box
              because both are ways of saying who you mean, and because a
              shopkeeper with a sack in one hand has neither hand for a
              keypad.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceEntry"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/voice_entry"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/gold_on_dark" />

            <!--
              Which stretch of days to show. Beside the sort: both narrow the
              same list, and "who did I deal with today" is a question asked
              at every closing.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterPartyDate"
                android:minWidth="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/range_all"
                android:textColor="@color/gold_on_dark"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/gold_on_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortParties"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="@string/sort"
                android:textColor="@color/header_on_dark"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/header_on_dark" />
        </LinearLayout>

        <!--
          What the microphone understood, answered in place.

          This was a full dialog: a title, three lines of message and two
          spread buttons, covering the list it was talking about. It is one
          strip now, directly under the mic that produced it — the owner reads
          a line, and either opens the entry or dismisses it. Nothing is saved
          from here either way; Open Entry still lands on the party's screen
          where the credit-limit warning and every other check run.
        -->
        <LinearLayout
            android:id="@+id/voiceStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_voice_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVoiceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Bilal  ·  Rs 5,000  ·  I Gave" />

                <TextView
                    android:id="@+id/tvVoiceHeard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    tools:text="Heard: bilal ko paanch hazaar diye" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceOpen"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/voice_open_entry"
                android:textColor="@color/brand_green"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceDismiss"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/cancel"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_muted" />
        </LinearLayout>

        <!--
          A one-line summary under the search: how many customers, and how many
          have a balance that has gone quiet for a while (nothing for 30 days).
          The overdue count is what the competitor surfaces as "reminders" — the
          owner's cue for who to follow up with. Both sit on the green header, so
          they use the soft on-header tint.
        -->
        <TextView
            android:id="@+id/tvPartySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:textColor="@color/header_on_dark"
            android:textSize="12sp" />
    </LinearLayout>

    <!--
      The main sections, out in the open. They were buried in an overflow menu
      before, which in practice meant most shopkeepers would never have
      discovered that a Cashbook or a Cheque register existed at all.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/nav_item_colour"
        app:itemTextColor="@color/nav_item_colour"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_home_nav" />

    <!--
      The selection bar, shown only while customers are being picked.
      
      It sits between the header and the list rather than replacing the
      header, so the balances stay in view the whole time — a shopkeeper
      about to remove a batch of customers should be able to see what the
      shop is owed while they do it.

      Gone by default. Constrained so the list starts below it, which in a
      ConstraintLayout means the list simply starts at the header when the
      bar is not there.
    -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/section_khata"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectAll"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_all"
            android:textColor="@color/gold_on_dark"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteSelected"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:textColor="@color/red_gave_on_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvParties"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selectionBar" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/no_parties_yet"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvParties"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvParties" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddParty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/add_party"
        android:textColor="@color/white"
        app:backgroundTint="@color/ink"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
