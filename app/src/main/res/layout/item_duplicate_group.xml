<?xml version="1.0" encoding="utf-8"?>
<!--
  One group of records that may be one person (6 Nov 2026, the owner's photo: every record was one sentence,
  "name — number — Rs 0", broken anywhere at 150% text, the numbers in three shapes, and "Review & merge" plain
  words under it). Now a card: why they were grouped and how many, a warning where the numbers say something,
  each record on its own two lines (the name; its number and balance), and two buttons sharing the row by weight
  (lesson 58): "Not a duplicate" and "Review & merge". DuplicateGroupAdapter fills it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_profile_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDupReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:textColor="@color/brand_green_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDupCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_lang_tag"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/gold_ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDupCaution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAlignment="viewStart"
        android:textColor="@color/gold_ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dupMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDupNotSame"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:maxLines="2"
            android:minHeight="48dp"
            android:text="@string/duplicate_not_duplicate"
            android:textAllCaps="false"
            android:textColor="@color/brand_green_text"
            app:cornerRadius="12dp"
            app:strokeColor="@color/brand_green_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDupMerge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:maxLines="2"
            android:minHeight="48dp"
            android:text="@string/duplicate_review_merge"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
