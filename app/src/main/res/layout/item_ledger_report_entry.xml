<?xml version="1.0" encoding="utf-8"?>
<!-- One entry in the whole-ledger report. The two 96dp money columns match
     the pinned column header above the list exactly, so every amount falls
     on the same vertical line as its label — measured against the header,
     not guessed. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLrEntryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvLrEntryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLrEntryGave"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/red_gave"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLrEntryGot"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/green_got"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
