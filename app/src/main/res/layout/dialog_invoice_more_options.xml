<?xml version="1.0" encoding="utf-8"?>
<!--
  Discount, tax and payment for an invoice (13 Oct 2026), a bottom sheet in
  place of the old dialog whose two-to-a-row boxes cut their own hints short
  ("Discount % (c", "Extra charge (optio"). Each field now has the full width
  and its label above it, the discount can be a percent or an amount in
  money, and the sum at the bottom is worked out live from the same
  InvoiceMath the PDF prints with, so the owner sees the balance before he
  applies anything. Each field still follows its switch in Invoice settings.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/invoice_more_title"
                android:textColor="@color/ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/invoice_more_sub"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMoreClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="@color/ink_soft" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <!-- Discount: a percent or an amount, one of the two. -->
            <LinearLayout
                android:id="@+id/blockDiscount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SheetFieldLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:labelFor="@+id/etInvoiceDiscount"
                        android:text="@string/invoice_discount_label" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleDiscountKind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDiscountPercent"
                            style="@style/SheetToggleButton"
                            android:text="%" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDiscountAmount"
                            style="@style/SheetToggleButton"
                            android:text="@string/invoice_discount_kind_amount" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <EditText
                    android:id="@+id/etInvoiceDiscount"
                    style="@style/EditorField"
                    android:layout_marginTop="6dp"
                    android:digits="0123456789.+−×÷*/-%"
                    android:hint="@string/invoice_discount_example"
                    android:inputType="phone"
                    android:textAlignment="viewStart"
                    android:textDirection="ltr" />

                <TextView
                    android:id="@+id/tvDiscountResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/brand_green_text"
                    android:textDirection="ltr"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blockTax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SheetFieldLabel"
                    android:labelFor="@+id/etInvoiceTax"
                    android:text="@string/invoice_tax_label" />

                <EditText
                    android:id="@+id/etInvoiceTax"
                    style="@style/EditorField"
                    android:layout_marginTop="6dp"
                    android:hint="@string/invoice_tax_example"
                    android:inputType="numberDecimal"
                    android:textAlignment="viewStart"
                    android:textDirection="ltr" />
            </LinearLayout>

            <!-- Extra charge is a pair: a name with no amount means nothing. -->
            <LinearLayout
                android:id="@+id/rowExtraChargeFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SheetFieldLabel"
                    android:text="@string/invoice_feature_extra_charge" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etChargeLabel"
                        style="@style/EditorField"
                        android:layout_width="0dp"
                        android:layout_weight="1.4"
                        android:hint="@string/invoice_charge_example"
                        android:inputType="textCapSentences" />

                    <EditText
                        android:id="@+id/etChargeAmount"
                        style="@style/EditorField"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:digits="0123456789.+−×÷*/-%"
                        android:hint="@string/invoice_charge_amount_hint"
                        android:inputType="phone"
                        android:textAlignment="viewStart"
                        android:textDirection="ltr" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvChargeResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/brand_green_text"
                    android:textDirection="ltr"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Blank means nothing recorded yet: a template then leaves the
                 Balance Due line off entirely rather than printing zero. -->
            <LinearLayout
                android:id="@+id/blockReceived"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SheetFieldLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:labelFor="@+id/etReceived"
                        android:text="@string/invoice_received_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReceivedFull"
                        style="@style/SheetQuickButton"
                        android:text="@string/invoice_received_full" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReceivedNone"
                        style="@style/SheetQuickButton"
                        android:layout_marginStart="6dp"
                        android:text="@string/invoice_received_none" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etReceived"
                    style="@style/EditorField"
                    android:layout_marginTop="6dp"
                    android:digits="0123456789.+−×÷*/-%"
                    android:hint="@string/invoice_charge_amount_hint"
                    android:inputType="phone"
                    android:textAlignment="viewStart"
                    android:textDirection="ltr" />

                <TextView
                    android:id="@+id/tvReceivedResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/brand_green_text"
                    android:textDirection="ltr"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blockNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SheetFieldLabel"
                    android:labelFor="@+id/etInvoiceNote"
                    android:text="@string/invoice_note_label" />

                <EditText
                    android:id="@+id/etInvoiceNote"
                    style="@style/EditorField"
                    android:layout_marginTop="6dp"
                    android:hint="@string/invoice_note_example"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3" />
            </LinearLayout>

            <!-- The sum, live: what the invoice will print. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout style="@style/SumRow">
                    <TextView style="@style/SumLabel" android:text="@string/invoice_sum_items" />
                    <TextView android:id="@+id/tvSumItems" style="@style/SumValue" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowSumDiscount" style="@style/SumRow">
                    <TextView android:id="@+id/tvSumDiscountLabel" style="@style/SumLabel" />
                    <TextView android:id="@+id/tvSumDiscount" style="@style/SumValue" android:textColor="@color/red_gave_text" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowSumTax" style="@style/SumRow">
                    <TextView android:id="@+id/tvSumTaxLabel" style="@style/SumLabel" />
                    <TextView android:id="@+id/tvSumTax" style="@style/SumValue" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowSumCharge" style="@style/SumRow">
                    <TextView android:id="@+id/tvSumChargeLabel" style="@style/SumLabel" />
                    <TextView android:id="@+id/tvSumCharge" style="@style/SumValue" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/hairline" />

                <LinearLayout style="@style/SumRow">
                    <TextView style="@style/SumLabel" android:text="@string/invoice_sum_total" android:textColor="@color/ink" android:textStyle="bold" />
                    <TextView android:id="@+id/tvSumTotal" style="@style/SumValue" android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowSumReceived" style="@style/SumRow">
                    <TextView style="@style/SumLabel" android:text="@string/invoice_sum_received" />
                    <TextView android:id="@+id/tvSumReceived" style="@style/SumValue" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowSumBalance" style="@style/SumRow">
                    <TextView style="@style/SumLabel" android:text="@string/invoice_sum_balance" android:textColor="@color/brand_green_text" android:textStyle="bold" />
                    <TextView android:id="@+id/tvSumBalance" style="@style/SumValue" android:textColor="@color/brand_green_text" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- The app's calculator pad (21 Oct), pinned above Apply while a money
         box has the focus — the discount in money, the extra charge, the
         amount received — and typing into that box. Gone for the label,
         the tax, the note, and the discount in %: a lone "10%" on the pad
         would come out as 0.10 (InvoiceEditorActivity, CalcPad.bindAll). -->
    <include
        android:id="@+id/moreKeypad"
        layout="@layout/view_calculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMoreApply"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/invoice_more_apply"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
