<?xml version="1.0" encoding="utf-8"?>
<!--
  Products & stock (2 Nov 2026, the owner's photos at 150% text: the two register cards, the tie
  button and the Add product button stood fixed under the list and left room for one product,
  with the button over it). The band with the search stays; everything else under it moves with
  the list: the figures, the registers (one card, two rows) and the note with its tie button
  scroll away as the list is scrolled up and come back as it comes down (an AppBarLayout over the
  list), so the products have the whole screen. Add product shrinks to its "+" while the list
  scrolls down (ProductsActivity).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/section_bills"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- The title above its two buttons (30 Oct 2026, the phone audit: beside Rate list and the more
             button the 21 sp title kept ~100 dp and split mid-word at 130% text). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/products_stock"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/products_subtitle"
                    android:textColor="@color/section_bills_soft"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

            <!--
              The rate list is sent from the products it lists. A labelled
              button, not a bare icon: "send my prices" is not something a
              share glyph in a corner says on its own. A tile on the band like
              the Supplier Bills tools (13 Oct), one line always.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRateList"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:maxWidth="170dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/rate_list_title"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/header_tile_fill"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/gold_on_dark"
                app:strokeColor="@color/header_tile_stroke" />

            <!-- The list as a spreadsheet and back (POS Phase 2): a small more
                 button beside Rate list, so the band keeps one line. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProductsMore"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/products_export"
                app:backgroundTint="@color/header_tile_fill"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_more_vert"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/white"
                app:strokeColor="@color/header_tile_stroke" />
            </LinearLayout>
        </LinearLayout>

        <!-- Find a product by name (13 Oct): a dealer stocks dozens. -->
        <EditText
            android:id="@+id/etProductSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_header_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="@color/section_bills_soft"
            android:hint="@string/products_search_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/white"
            android:textColorHint="@color/section_bills_soft"
            android:textSize="15sp" />
    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/productsTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/page_bg"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                app:layout_scrollFlags="scroll|enterAlways">

                <!-- What is on the shelf at a glance (13 Oct): how many products, and how
                     many have run out by the bills and sales entered. -->
                <LinearLayout
                    android:id="@+id/productStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp">

                    <LinearLayout style="@style/StatTile">
                        <TextView android:id="@+id/tvStatProducts" style="@style/StatTileValue" />
                        <TextView style="@style/StatTileLabel" android:text="@string/stat_products" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatTile" android:layout_marginStart="8dp">
                        <TextView android:id="@+id/tvStatOut" style="@style/StatTileValue" android:textColor="@color/red_gave_text" />
                        <TextView style="@style/StatTileLabel" android:text="@string/stat_out_of_stock" />
                    </LinearLayout>
                </LinearLayout>

                <!-- The two registers this screen prints, one card with a row each: the stock
                     register and what came in and went out over a period. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/page_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/btnInspectorReport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_register_icon">

                                <ImageView
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_register_stock"
                                    app:tint="@color/section_bills_text" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:textAlignment="viewStart"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/inspector_title"
                                    android:textColor="@color/ink"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="viewStart"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/inspector_subtitle"
                                    android:textColor="@color/ink_soft"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/ink_soft" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="66dp"
                            android:background="@color/page_line" />

                        <LinearLayout
                            android:id="@+id/btnRegisterReport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_register_icon">

                                <ImageView
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_register_sales"
                                    app:tint="@color/section_bills_text" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:textAlignment="viewStart"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/register_title"
                                    android:textColor="@color/ink"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="viewStart"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/register_subtitle"
                                    android:textColor="@color/ink_soft"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/ink_soft" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- The app's own limit, admitted rather than hidden, with the one-off job that
                     lifts it right under the words that send the owner to it ("the button below").
                     A quiet text button: tying old entries is done once, not weekly. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_note_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvProductsNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/products_note"
                        android:textAlignment="viewStart"
                        android:textColor="@color/note_text"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLinkGoods"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:minHeight="48dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="8dp"
                        android:letterSpacing="0"
                        android:text="@string/link_goods"
                        android:textAlignment="viewStart"
                        android:textAllCaps="false"
                        android:textColor="@color/note_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconGravity="end"
                        app:iconSize="18dp"
                        app:iconTint="@color/note_text" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- The list and its empty state share the space under the top; the list's nested
             scrolling still reaches the coordinator through this frame. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- The bottom padding keeps the last product clear of the Add product button. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="88dp" />

            <!-- Empty: a picture and the reason (13 Oct). -->
            <LinearLayout
                android:id="@+id/emptyProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_empty_icon_bills">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tile_products" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNoProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/no_products"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!--
          Add product (30 Oct 2026): until now a product came only from a name on a bill or an entry,
          so a new book's counter, which sells only products, had nothing to find. Hidden on a
          helper's read-only phone; shrinks to its "+" while the list scrolls down.
        -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAddProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/product_add"
            android:maxWidth="260dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/product_add"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/button_dark"
            app:icon="@drawable/ic_add_plain"
            app:iconTint="@color/white" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
