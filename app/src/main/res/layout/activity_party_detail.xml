<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <!--
      The light header (P2, 7 Oct): the same pale-mint band as Home and the
      Khata list, deep-green ink, paper tiles. This screen was the last one
      still wearing the brand-green block with gold outlines, so a tap from
      the Khata list landed in a different app.
    -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_light"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:minHeight="48dp"
            android:id="@+id/detailToolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="-14dp"
            app:theme="@style/ToolbarHeaderLight"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light" />

        <!--
          Avatar beside a column of name, number and identity, the column
          centred on the avatar. The number used to sit on its own line under
          the avatar, so a two-line name left the circle floating high and
          the number hanging off to the left of everything else.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/flAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/tvDetailInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:textColor="@color/ink_soft"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivDetailAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/party_photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!--
                  A camera on the corner of the circle. Tapping the avatar
                  already set a photo, but nothing said so — it looked like a
                  monogram, and a control nobody can see is a control nobody
                  uses.
                -->
                <ImageView
                    android:id="@+id/ivAvatarCameraBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_avatar_camera"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPartyName"
                    android:textAlignment="viewStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/header_light_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- The handset is a compound drawable, so it hides with the number. -->
                <TextView
                    android:id="@+id/tvPartyPhone"
                    android:textDirection="ltr"
                    android:textAlignment="viewStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawableStart="@drawable/ic_phone_small"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/header_light_ink_soft"
                    android:gravity="center_vertical"
                    android:textColor="@color/header_light_ink_soft"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!--
                  Father's name and village on ONE line, smaller and dimmer than the
                  number above it. Gone entirely when neither is known, so a customer
                  entered before these fields existed sees the screen unchanged.
                -->
                <TextView
                    android:id="@+id/tvPartyIdentity"
                    android:textAlignment="viewStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/header_light_ink_soft"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- Fasal ka Hisaab (2 Oct): this customer's last seasons, before
                     more credit is given — a gold chip now, the Today-strip's
                     shape in the Bills tile's hue. -->
                <TextView
                    android:id="@+id/tvSeasonRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_season_chip"
                    android:paddingStart="9dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/fi_gold_b"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!--
          The balance as the same paper card Home and the Khata list use for
          "I have to get": an arrow chip in the direction's tint, the figure
          in the direction's colour, the hint muted. The chip's fill, glyph
          and the figure's colour are swapped in updateBalanceHeader.
        -->
        <LinearLayout
            android:id="@+id/balanceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ledger_summary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/ivBalanceChip"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_chip_get"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_got"
                app:tint="@color/bal_owed_to_me" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPartyBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/bal_owed_to_me"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBalanceHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!--
          The four actions — Call, WhatsApp, SMS, Statement — as the Home
          tiles: a paper card, the glyph on a tinted square in a hue of its
          own (green, green, blue, orange: the tile_*_bg / fi_*_b pairs of
          colors.xml, repainted together at night), the label in ink below.
          They were gold-outlined buttons on the green block.

          baselineAligned=false, match_parent height, so the row lines the
          four up by their EDGES, not by their text: a Latin label ("SMS")
          sits on a different baseline from an Arabic-script one. Labels
          auto-size down to 7sp so the longest locale never wraps or clips.
        -->
        <LinearLayout
            android:id="@+id/reminderBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="4">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/page_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_tile_icon"
                        android:backgroundTint="@color/tile_khata_bg"
                        android:importantForAccessibility="no"
                        android:padding="7dp"
                        android:src="@drawable/ic_action_call"
                        app:tint="@color/fi_green_b" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="@string/call"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnWhatsApp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/page_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_tile_icon"
                        android:backgroundTint="@color/tile_followup_bg"
                        android:importantForAccessibility="no"
                        android:padding="7dp"
                        android:src="@drawable/ic_action_whatsapp"
                        app:tint="@color/fi_teal_b" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="@string/remind_whatsapp"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSms"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/page_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_tile_icon"
                        android:backgroundTint="@color/tile_insights_bg"
                        android:importantForAccessibility="no"
                        android:padding="7dp"
                        android:src="@drawable/ic_action_sms"
                        app:tint="@color/fi_blue_b" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="@string/remind_sms"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPdf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/page_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_tile_icon"
                        android:backgroundTint="@color/tile_stock_bg"
                        android:importantForAccessibility="no"
                        android:padding="7dp"
                        android:src="@drawable/ic_pdf_doc"
                        app:tint="@color/fi_orange_b" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="@string/statement_pdf"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!--
          Search, date range, sort: the Khata list's search row — the same
          field, the filter as a violet tile and the sort as a blue one, the
          two hues those tools wear on the list. The range button keeps its
          word ("All", "This month"...) because the code writes the chosen
          range into it; the sort tile is its glyph alone, named for TalkBack.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearchEntries"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_muted"
                android:hint="@string/search_entries"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterEntryDate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:text="@string/range_all"
                android:textColor="@color/fi_violet_b"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/tile_card_bg"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_filter_sliders"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="18dp"
                app:iconTint="@color/fi_violet_b"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortEntries"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="50dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/sort"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:backgroundTint="@color/tile_insights_bg"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_sort_arrows"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/fi_blue_b"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEntries"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBarContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <TextView
        android:id="@+id/tvNoEntries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_entries_yet"
        android:textColor="@color/brand_green_text"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvEntries"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvEntries" />

    <!--
      Both bars share this one container so rvEntries has a single stable
      anchor no matter which bar is showing — a FrameLayout sizes itself to
      whichever child is actually VISIBLE, so swapping which bar shows
      moves the boundary correctly instead of leaving a gap or an overlap.
    -->
    <FrameLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/buttonBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGave"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.04"
                android:maxLines="1"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform"
                android:text="@string/i_gave"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/red_gave"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_gave"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGot"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.04"
                android:maxLines="1"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform"
                android:text="@string/i_got"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/green_got"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_got"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!--
          Takes the Gave/Got bar's own spot rather than adding a third row —
          this only ever appears once "Select entries to delete" is chosen
          from the menu, and Gave/Got has no meaning while picking what to
          remove.
        -->
        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/page_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/cbSelectAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/select_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSelection"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:enabled="false"
                android:text="@string/delete"
                android:textColor="@color/delete_selected_button_fg"
                app:backgroundTint="@color/delete_selected_button_bg"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
