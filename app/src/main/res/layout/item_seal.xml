<?xml version="1.0" encoding="utf-8"?>
<!-- One day's seal: when, the entries it holds, and a tick per witness. Each on its own full-width line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_profile_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:textAlignment="viewStart"
        android:id="@+id/tvSealDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:textAlignment="viewStart"
        android:id="@+id/tvSealEntries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ink"
        android:textSize="13sp" />

    <TextView
        android:textAlignment="viewStart"
        android:id="@+id/tvSealWitnesses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />
</LinearLayout>
