<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cheque_not_money_yet"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <AutoCompleteTextView
            style="@style/EditorField"
            android:popupBackground="@drawable/bg_dropdown_popup"
            android:dropDownVerticalOffset="4dp"
            android:id="@+id/etChequeParty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:completionThreshold="1"
            android:hint="@string/cheque_party_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <RadioGroup
            android:id="@+id/rgChequeDirection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbReceived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/cheque_received"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbIssued"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/cheque_issued"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- The amount is written on the app's calculator pad (21 Oct): the
             pad shows while this box has the focus, steps aside for the
             phone's keyboard in the other boxes (CalcPad.bindAll). Its own
             characters (− × ÷ %) must be in digits, or Android's digits
             filter drops them as the pad adds them. -->
        <EditText
            style="@style/EditorField"
            android:id="@+id/etChequeAmount"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/amount"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:digits="0123456789.+−×÷*/-%" />

        <TextView
            android:id="@+id/tvChequeAmountResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/brand_green_text"
            android:textDirection="ltr"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <include
            android:id="@+id/chequeKeypad"
            layout="@layout/view_calculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickDueDate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="@color/ink"
        app:strokeColor="@color/editor_field_stroke"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/pick_due_date"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cornerRadius="8dp" />

        <EditText
            style="@style/EditorField"
            android:id="@+id/etChequeNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/cheque_number_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            style="@style/EditorField"
            android:id="@+id/etBankName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/bank_name_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            style="@style/EditorField"
            android:id="@+id/etChequeNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/note_optional"
            android:importantForAutofill="no"
            android:inputType="text" />

        <!-- The cheque's picture (schema 43), on a new cheque: kept on this phone with it, as a bill's photo is.
             A cheque already written changes its picture from its own menu (ChequesActivity.showChequeActions). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChequePhoto"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="start|center_vertical"
            android:text="@string/attach_photo"
            android:textAllCaps="false"
            android:textColor="@color/brand_green_text"
            android:textSize="14sp"
            android:visibility="gone"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconTint="@color/brand_green_text" />

    </LinearLayout>
</ScrollView>
