<?xml version="1.0" encoding="utf-8"?>
<!--
  A cashbook entry. The amount is written on the app's own calculator pad
  (21 Oct), the one the add-entry form has: the pad shows while the amount
  has the focus and steps aside for the phone's keyboard in the category and
  note boxes (CashbookActivity, CalcPad.bindAll). A ScrollView since then:
  with the pad the form is taller than a short phone's dialog.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <!-- The pad's own characters (− × ÷ %) must be in digits: Android's
         digits filter also drops text the pad adds from code. -->
    <EditText
        android:id="@+id/etCashAmount"
        android:textDirection="ltr"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/amount"
        android:importantForAutofill="no"
        android:inputType="phone"
        android:digits="0123456789.+−×÷*/-%" />

    <!-- The running total of a sum, green, under what was typed. -->
    <TextView
        android:id="@+id/tvCashAmountResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/brand_green_text"
        android:textDirection="ltr"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <include
        android:id="@+id/cashKeypad"
        layout="@layout/view_calculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <AutoCompleteTextView
        android:popupBackground="@drawable/bg_dropdown_popup"
        android:dropDownVerticalOffset="4dp"
        android:id="@+id/etCashCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:completionThreshold="1"
        android:hint="@string/cash_category_hint"
        android:importantForAutofill="no"
        android:inputType="text" />

    <!--
      How the money moved (29 Oct): Cash unless the owner taps another way, as
      the khata's "I got" starts — the day's count looks in the drawer only for
      cash. The chips are the add-entry form's, built in code from
      PaymentMethod.ALL (CashbookActivity) so the two forms cannot drift apart.
      One line that slides sideways, as on that form.
    -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/payment_method_label"
        android:textColor="@color/brand_green_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgCashMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- The payment's own id (schema 39): shown only beside a way that has one (PaymentRef). -->
    <EditText
        android:id="@+id/etCashRef"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/pos_reference_hint"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword|textNoSuggestions"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textDirection="ltr"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etCashNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/note_optional"
        android:importantForAutofill="no"
        android:inputType="text" />

    <!--
      When the cash moved, not when it was written down. Same control as a
      party entry carries, for the same reason: the day's cash is often
      totalled up at closing time.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCashDate"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start|center_vertical"
        android:textAllCaps="false"
        android:textColor="@color/brand_green_text"
        android:textSize="14sp"
        app:icon="@drawable/ic_calendar"
        app:iconGravity="textStart"
        app:iconTint="@color/brand_green_text" />

</LinearLayout>
</ScrollView>
