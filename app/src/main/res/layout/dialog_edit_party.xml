<?xml version="1.0" encoding="utf-8"?>
<!--
  Editing a customer who already exists.
  
  Until now the only way to fix a misspelt name or a wrong number was to
  create a second account and move on, which is how a book ends up with two
  of the same person. The father-name and village fields are here for the
  same reason: they arrived after most customers were already entered, and a
  field that can only be filled in at creation is a field the existing
  hundred can never have.

  Party type and credit limit are NOT here — each already has its own item in
  this screen's menu, and duplicating them would give two places to change
  one thing.
-->
<!-- A ScrollView since the private note (schema 43): with it the form is taller than a short phone's dialog at
     large text, and the keyboard takes half of what is left. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <EditText
        style="@style/EditorField"
        android:id="@+id/etEditName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/name"
        android:importantForAutofill="no"
        android:inputType="textPersonName" />

    <EditText
        style="@style/EditorField"
        android:id="@+id/etEditPhone"
        android:textDirection="ltr"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/phone_optional"
        android:importantForAutofill="no"
        android:inputType="phone" />

    <EditText
        style="@style/EditorField"
        android:id="@+id/etEditFatherName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/father_name_optional"
        android:importantForAutofill="no"
        android:inputType="textPersonName" />

    <EditText
        style="@style/EditorField"
        android:id="@+id/etEditVillage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/village_optional"
        android:importantForAutofill="no"
        android:inputType="textCapWords" />

    <!-- The owner's private note (schema 43): a question longer than a hint goes above its box (lesson 59). -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/party_note_label"
        android:textAlignment="viewStart"
        android:textColor="@color/brand_green_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        style="@style/EditorField"
        android:id="@+id/etEditNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="top|start"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="500"
        android:minLines="2"
        android:textAlignment="viewStart" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/party_note_help"
        android:textAlignment="viewStart"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbNoEntryShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/party_no_entry_share"
        android:textSize="13sp" />

</LinearLayout>
</ScrollView>
