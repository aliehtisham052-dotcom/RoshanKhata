<?xml version="1.0" encoding="utf-8"?>
<!--
  Editing a customer who already exists.
  
  Until now the only way to fix a misspelt name or a wrong number was to
  create a second account and move on, which is how a book ends up with two
  of the same person. The father-name and village fields are here for the
  same reason: they arrived after most customers were already entered, and a
  field that can only be filled in at creation is a field the existing
  hundred can never have.

  Party type and credit limit are NOT here — each already has its own item in
  this screen's menu, and duplicating them would give two places to change
  one thing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/etEditName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/name"
        android:importantForAutofill="no"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/etEditPhone"
        android:textDirection="ltr"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/phone_optional"
        android:importantForAutofill="no"
        android:inputType="phone" />

    <EditText
        android:id="@+id/etEditFatherName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/father_name_optional"
        android:importantForAutofill="no"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/etEditVillage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/village_optional"
        android:importantForAutofill="no"
        android:inputType="textCapWords" />

</LinearLayout>
