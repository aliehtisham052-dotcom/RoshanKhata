<?xml version="1.0" encoding="utf-8"?>
<!--
  A feature's first-open sheet (1 Nov 2026, after a competitor's QR sheet the owner liked): three
  numbered pictures of how it works, the feature's name, the one line on what it does for the shop,
  and one button. Shown once per feature on this phone; Help lists them all again. ui/FeatureIntro.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sheet_grabber" />

        <LinearLayout
            android:id="@+id/introSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvIntroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_horizontal"
            android:textAlignment="center"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIntroBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="2dp"
            android:textAlignment="center"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIntroDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="52dp"
            android:text="@string/coach_done"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="14dp" />

        <!-- Back, a swipe down or a tap above close the sheet as Got it does (Android's rule for a sheet: Back
             closes the top layer); this line says where it can be read again (10 Nov 2026, the owner). -->
        <TextView
            android:id="@+id/tvIntroAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/intro_find_again"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
