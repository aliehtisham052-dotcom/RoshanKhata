<?xml version="1.0" encoding="utf-8"?>
<!--
  The price check (3 Nov 2026, the competitor study): a code scanned, or typed into the products search, shows
  the product's two prices, what is on the shelf and where it is kept — and puts nothing on a ticket. Who bought
  it and its details open from here as from its row. ui/PriceCheckSheet.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_sheet_grabber" />

        <TextView
            android:id="@+id/tvPriceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPriceSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- The two prices side by side; each figure keeps to one line, smaller when it is long (150% text). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_editor_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/sale_price_hint"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPriceCash"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="24sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editor_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/credit_price_hint"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPriceCredit"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="24sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPriceStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPricePlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAlignment="viewStart"
            android:textColor="@color/ink_soft"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPriceBuyers"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:text="@string/product_who_bought"
            android:textAllCaps="false"
            android:textColor="@color/brand_green_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/brand_green_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPriceEdit"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="@string/product_edit_details"
            android:textAllCaps="false"
            android:textColor="@color/brand_green_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/brand_green_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPriceClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/close"
            android:textAllCaps="false"
            android:textColor="@color/brand_green_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
