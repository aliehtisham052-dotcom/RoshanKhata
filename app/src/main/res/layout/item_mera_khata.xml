<?xml version="1.0" encoding="utf-8"?>
<!--
  One shop on Mera Khata (7 Nov 2026): the shop, the name it keeps the account under, which way the balance runs
  and the amount, when the shop last wrote, the last entries only when the shop shows them, and a status line when
  the page could not be read. MeraKhataActivity fills it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_profile_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMkShop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMkMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mera_khata_remove"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/text_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMkName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        android:textAlignment="viewStart"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvMkSide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingEnd="8dp"
        android:textAlignment="viewStart"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvMkAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        android:textAlignment="viewStart"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMkUpdated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        android:textAlignment="viewStart"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvMkLines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="4dp"
        android:paddingEnd="8dp"
        android:textAlignment="viewStart"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMkStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingEnd="8dp"
        android:textAlignment="viewStart"
        android:textColor="@color/gold_ink"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
