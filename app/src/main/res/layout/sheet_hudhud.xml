<?xml version="1.0" encoding="utf-8"?>
<!--
  Hudhud's sheet (12 Nov 2026, ui/HudhudSheet): Hudhud and what he is doing; what he understood; his answer on a
  card with its one way onward; the questions he knows, as chips; the box and the microphone to ask him. Every word
  is sp and every row grows with its words (lesson 58): the two buttons under an answer share their row by weight,
  the second one a ring with no words. The sheet's colour and rounded top are its frame's
  (ThemeOverlay.RoshanKhata.HudhudSheet), so the page colour also runs under the navigation bar.

  Only the middle scrolls (the same day, the 150% proofs): a long answer (a help page, the Radar's reasons) pushed the
  chips and the box under the navigation bar, and asking again meant scrolling down first. Hudhud stays at the top and
  the chips and the box at the foot, as a chat keeps its message bar; what he understood and his answer take what is
  left (0dp with a weight: a short answer is wrapped, a long one scrolls in the room there is).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_grabber" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <!-- A tap on Hudhud plays one of his acts (13 Nov 2026, the owner: "touch karne par kabhi urre, kabhi pankh
             maare"): HudhudActs, over the window above the sheet. His act is the answer to the touch: no ripple
             (fg_hudhud_stage only rings him for keyboard focus; the ripple was cut to a grey box). -->
        <FrameLayout
            android:id="@+id/hudStage"
            android:layout_width="96dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_hudhud_stage"
            android:clickable="true"
            android:contentDescription="@string/hudhud_name"
            android:focusable="true"
            android:foreground="@drawable/fg_hudhud_stage">

            <ImageView
                android:id="@+id/ivHudPoseA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/hudhud_idle" />

            <ImageView
                android:id="@+id/ivHudPoseB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvHudName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hudhud_name"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHudState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityLiveRegion="polite"
                android:textAlignment="viewStart"
                android:textColor="@color/brand_green_text"
                android:textSize="14sp" />

            <!-- His voice settings (13 Nov 2026): under his name, not a third button in this row, which left his
                 name a few letters wide on a 360 dp phone at 150% (lesson 58). -->
            <TextView
                android:id="@+id/btnHudSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="6dp"
                android:gravity="center_vertical|start"
                android:minHeight="40dp"
                android:text="@string/hudhud_settings"
                android:textAlignment="viewStart"
                android:textColor="@color/brand_green_text"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_tune"
                app:drawableTint="@color/brand_green_text" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHudVoice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hudhud_voice_on"
            android:scaleType="center"
            android:src="@drawable/ic_volume_on"
            app:tint="@color/brand_green_text" />

        <ImageButton
            android:id="@+id/btnHudClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:scaleType="center"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/hudScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHudHeard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAlignment="viewStart"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cardHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_hudhud_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- What a sentence nothing fitted exactly was taken as (13 Nov 2026): over the answer, so a wrong
                     reading is seen at once. -->
                <TextView
                    android:id="@+id/tvHudTook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/brand_green_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHudLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/gold_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHudFigure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/brand_green_text"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHudLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textAlignment="viewStart"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/hudRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHudNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/hudButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHudOpen"
                        style="@style/BackupPrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:text="@string/vq_open" />

                    <ImageButton
                        android:id="@+id/btnHudReplay"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_hudhud_ring"
                        android:contentDescription="@string/hudhud_replay"
                        android:scaleType="center"
                        android:src="@drawable/ic_volume_on"
                        app:tint="@color/brand_green_text" />
                </LinearLayout>

                <!-- The owner's check of a test build (14 Nov 2026, HudhudCheck): while it is on, each answer is
                     marked right or wrong here and kept on this phone, so the build's success rate is counted. -->
                <LinearLayout
                    android:id="@+id/hudCheckRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvHudCheck"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hudhud_check_ask"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHudRight"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/hudhud_check_right"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_green_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHudWrong"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="44dp"
                        android:text="@string/hudhud_check_wrong"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_green_text" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <HorizontalScrollView
        android:id="@+id/hudChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/hudChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etHudAsk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_hudhud_field"
            android:hint="@string/hudhud_ask"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:minHeight="52dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnHudMic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_hudhud_mic"
            android:contentDescription="@string/vq_ask"
            android:scaleType="center"
            android:src="@drawable/ic_mic" />
    </LinearLayout>
</LinearLayout>
