<?xml version="1.0" encoding="utf-8"?>
<!--
  Hudhud's sheet (12 Nov 2026, redrawn 14 Nov 2026, ui/HudhudSheet): the open sky at the top, where he perches and flies
  (HudhudActs); his name and what he is doing, with the three small buttons; what he understood; his answer on a card
  with its one way onward; the questions he knows, as chips; the box and the one round button that is a microphone, a
  stop while he listens and "send" once something is typed.

  The owner's words (14 Nov 2026): "sheet upar se khaali ho, aur Hudhud ek jagah se doosri jagah thodi movement kare" — so
  nothing but his three perches and his shadow stands in the sky, and he never leaves it. With the keyboard up the sky
  shrinks to a low band (HudhudSheet.applyCompact) and the chips give way, so what is typed and what he answers stay in sight.

  Every word is sp and every row grows with its words (lesson 58). The sheet's colour and rounded top are its frame's
  (ThemeOverlay.RoshanKhata.HudhudSheet), so the page colour also runs under the navigation bar. Only the middle scrolls:
  a long answer (a help page, the Radar's reasons, a verse) never pushes the chips and the box under the navigation bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_grabber" />

    <!-- The sky. clipChildren off so his shadow and a squash are never cut; he is placed by HudhudActs (perches at the
         start, the middle and the end, laid out again whenever the width changes), never by gravity. -->
    <FrameLayout
        android:id="@+id/hudSky"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hudhud_sky"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/hudPerchA"
            android:layout_width="64dp"
            android:layout_height="6dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_hudhud_perch"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/hudPerchB"
            android:layout_width="64dp"
            android:layout_height="6dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_hudhud_perch"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/hudPerchC"
            android:layout_width="64dp"
            android:layout_height="6dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_hudhud_perch"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/hudShadow"
            android:layout_width="56dp"
            android:layout_height="8dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_hudhud_shadow"
            android:importantForAccessibility="no" />

        <!-- A tap on Hudhud plays one of his acts (13 Nov 2026, the owner: "touch karne par kabhi urre, kabhi pankh
             maare"): HudhudActs, in the sky above. His act is the answer to the touch: no ripple (fg_hudhud_stage only
             rings him for keyboard focus). -->
        <FrameLayout
            android:id="@+id/hudStage"
            android:layout_width="84dp"
            android:layout_height="92dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_hudhud_stage"
            android:clickable="true"
            android:contentDescription="@string/hudhud_name"
            android:focusable="true"
            android:foreground="@drawable/fg_hudhud_stage">

            <ImageView
                android:id="@+id/ivHudPoseA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/hudhud_idle" />

            <ImageView
                android:id="@+id/ivHudPoseB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </FrameLayout>

    <!-- His name and what he is doing, and three small buttons: his voice on or off, his voice settings, close. Each button
         is 44 dp, so the name keeps the rest of a 360 dp phone's width even at 150% text (lesson 58). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHudName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hudhud_name"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHudState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textAlignment="viewStart"
                android:textColor="@color/brand_green_text"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHudVoice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hudhud_voice_on"
            android:scaleType="center"
            android:src="@drawable/ic_volume_on"
            app:tint="@color/brand_green_text" />

        <ImageButton
            android:id="@+id/btnHudSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hudhud_settings"
            android:scaleType="center"
            android:src="@drawable/ic_tune"
            app:tint="@color/brand_green_text" />

        <ImageButton
            android:id="@+id/btnHudClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:scaleType="center"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/hudScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHudHeard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAlignment="viewStart"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cardHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_hudhud_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- What a sentence nothing fitted exactly was taken as (13 Nov 2026): over the answer, so a wrong
                     reading is seen at once. -->
                <TextView
                    android:id="@+id/tvHudTook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/brand_green_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHudLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/gold_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHudFigure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/brand_green_text"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHudLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textAlignment="viewStart"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/hudRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Verses (14 Nov 2026, HudhudFaith): only under an answer about Tawheed, hamd or the Prophet's risalat,
                     each an item_hudhud_verse; the note under them says the words above are a brief meaning. -->
                <LinearLayout
                    android:id="@+id/hudVerses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHudVerseNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHudNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/hudButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHudOpen"
                        style="@style/BackupPrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:text="@string/vq_open" />

                    <ImageButton
                        android:id="@+id/btnHudReplay"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_hudhud_ring"
                        android:contentDescription="@string/hudhud_replay"
                        android:scaleType="center"
                        android:src="@drawable/ic_volume_on"
                        app:tint="@color/brand_green_text" />
                </LinearLayout>

                <!-- The owner's check of a test build (14 Nov 2026, HudhudCheck): while it is on, each answer is
                     marked right or wrong here and kept on this phone, so the build's success rate is counted. -->
                <LinearLayout
                    android:id="@+id/hudCheckRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvHudCheck"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hudhud_check_ask"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHudRight"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/hudhud_check_right"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_green_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHudWrong"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="44dp"
                        android:text="@string/hudhud_check_wrong"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_green_text" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- The two tabs (14 Nov 2026, the owner: "personal tab ho, highlight na ho"): the shop's questions, and the quiet
         Personal one with his own story and the questions of faith. Small words with a line under the open one, no
         fill; they give way with the chips while the keyboard is up (HudhudSheet.applyCompact). -->
    <LinearLayout
        android:id="@+id/hudTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabHudAsk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hudhud_tab_on"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/hudhud_tab_ask"
            android:textColor="@color/brand_green_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabHudPersonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/hudhud_tab_personal"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hudChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/hudChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etHudAsk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_hudhud_field"
            android:hint="@string/hudhud_ask"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:minHeight="52dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <!-- One round button, three jobs (14 Nov 2026, the owner: "likhte hain to aage send aana chahiye"): the
             microphone when the box is empty, a stop while he listens, "send" once something is typed. -->
        <ImageButton
            android:id="@+id/btnHudMic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_hudhud_mic"
            android:contentDescription="@string/vq_ask"
            android:scaleType="center"
            android:src="@drawable/ic_mic" />
    </LinearLayout>
</LinearLayout>
