<?xml version="1.0" encoding="utf-8"?>
<!--
  "Customer's signature" as one row (18 Oct), the same on the new-entry form
  and in Edit: a pen icon, whether it is signed yet, a small picture of the
  signature once there is one, and Sign / Change plus a remove cross.
  Driven by ui/SignatureRow.kt.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sigRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/editor_field_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_section_icon">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_signature_pen"
                app:tint="@color/brand_green_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:textAlignment="viewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="none"
                android:text="@string/sig_label"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:textAlignment="viewStart"
                android:id="@+id/tvSigRowStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sig_none"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- The signature itself, small, under the words once there is one (beside them it squeezed
                 the title into broken pieces in the narrow Edit popup). Always on white: it is a document. -->
            <ImageView
                android:id="@+id/ivSigRowThumb"
                android:layout_width="104dp"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@color/white"
                android:contentDescription="@string/sig_label"
                android:padding="2dp"
                android:scaleType="fitStart"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSigRowAction"
            android:letterSpacing="0"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/sig_sign"
            android:textAllCaps="false"
            android:textColor="@color/brand_green_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSigRowRemove"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sig_remove"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
