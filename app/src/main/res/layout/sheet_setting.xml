<?xml version="1.0" encoding="utf-8"?>
<!--
  A personal setting's sheet (8 Nov 2026, the owner: Automations and Theme look professional, Screen privacy, App Lock
  and Payment Radar did not): the setting's icon and name with its On / Off pill, one or two short lines, the long
  text behind "Learn more", and one button that names the result. Built by ui/SettingSheet.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sheet_grabber" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/settingTile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tile_icon">

                <ImageView
                    android:id="@+id/ivSettingIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSettingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSettingState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_state_chip"
                android:minHeight="28dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSettingSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="2dp"
            android:textAlignment="viewStart"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvSettingMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:textAlignment="viewStart"
            android:textColor="@color/ink_soft"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnSettingLearn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:textAlignment="viewStart"
            android:textColor="@color/brand_green_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="52dp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="48dp"
            android:text="@string/close"
            android:textAllCaps="false"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
