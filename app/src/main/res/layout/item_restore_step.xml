<?xml version="1.0" encoding="utf-8"?>
<!--
  One step of a restore (ui/RestoreSteps): its mark and the line to the next step (ui/StepMark, added in
  code at the start, its height the row's), the step's words and an optional detail under them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/stepMarkSlot"
        android:layout_width="28dp"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:minHeight="52dp"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvStepLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textColor="@color/text_faint"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvStepDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
