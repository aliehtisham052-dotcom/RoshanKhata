<?xml version="1.0" encoding="utf-8"?>
<!-- One design in the poster screen's strip: a small picture of it. Its name is
     shown once, over the strip (designName), and read out from the picture. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="64dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/designCard"
        android:layout_width="58dp"
        android:layout_height="103dp"
        app:cardCornerRadius="9dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/hairline"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/designThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/designTick"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:tint="@color/brand_gold" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/designName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
