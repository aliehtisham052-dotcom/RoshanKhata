<?xml version="1.0" encoding="utf-8"?>
<!-- One language in the poster's language list: a radio, its own name, its name in the app's language. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="20dp">

    <RadioButton
        android:id="@+id/langRadio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:buttonTint="@color/brand_green_text" />

    <TextView
        android:id="@+id/langName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/langLocal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />
</LinearLayout>
