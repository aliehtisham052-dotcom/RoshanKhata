<?xml version="1.0" encoding="utf-8"?>
<!--
  Step 2 of 3 (9 Oct): backup, on the same painting as the language screen.

  Until now this screen was deep green with a second, differently drawn
  logo, between two light screens: the first run went light - dark - light,
  and the owner said the screens did not read as one app. It is now built
  exactly like the language screen: the splash painting at the top, placed
  by its tagline (SplashArt), fading into the paper, and under it a panel
  sized by its content - the step, the promise, a quiet note, and the two
  choices. The Google button keeps Google's own Light styling.

  Fixed colours by day and by night, like the painting itself.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F6F2">

    <FrameLayout
        android:id="@+id/welcomeStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="true"
        app:layout_constraintBottom_toTopOf="@id/welcomePanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivWelcomeArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="matrix"
            android:src="@drawable/splash_art" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_lang_fade" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/welcomePanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="420dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/welcomeStepDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvWelcomeStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.06"
                android:textColor="#8A6A15"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:text="@string/welcome_title"
            android:textColor="#0F4A33"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/welcome_body"
            android:textColor="#3E6B55"
            android:textSize="13.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_welcome_card"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield_check"
                app:tint="#8A6A15" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="@string/welcome_note"
                android:textAlignment="viewStart"
                android:textColor="#3E6B55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!--
          Shown only after a Google account actually connects, on THIS screen:
          anything shown after it finishes is covered by the next step.
        -->
        <LinearLayout
            android:id="@+id/welcomeSignedIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_welcome_signed"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_signed_in_title"
                    android:textAlignment="viewStart"
                    android:textColor="#1B5E3A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWelcomeSignedInEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAlignment="viewStart"
                    android:textColor="#3E6B55"
                    android:textDirection="ltr"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!--
          Google's Light "Sign in with Google" pill, per their branding
          guidelines: white fill, 1dp #747775 stroke, #1F1F1F Google Sans
          Medium, the standard-colour G, sentence case. Do not restyle.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWelcomeConnect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/google_sans_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/welcome_connect"
            android:textAllCaps="false"
            android:textColor="@color/google_btn_text"
            android:textSize="17sp"
            app:autoSizeMaxTextSize="17sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            app:backgroundTint="@color/white"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_google_g"
            app:iconGravity="textStart"
            app:iconPadding="13dp"
            app:iconSize="26dp"
            app:iconTint="@null"
            app:strokeColor="@color/google_btn_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWelcomeSkip"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/welcome_skip"
            android:textAllCaps="false"
            android:textColor="#1B5E3A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:rippleColor="#331B5E3A" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
