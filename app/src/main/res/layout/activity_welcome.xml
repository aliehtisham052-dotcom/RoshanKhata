<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!--
          The logo as it appears on the language screen (cut from
          lang_screen.webp, edges faded to transparent), on the same green, so
          the three first-run screens read as one. logo_full stays as it is:
          the lock screen and splash icon still use it.
        -->
        <ImageView
            android:layout_width="236dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_on_green"
            android:layout_marginTop="16dp" />

        <!-- Gold rule with a diamond, as under the logo on the language screen. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:importantForAccessibility="noHideDescendants">

            <View
                android:layout_width="90dp"
                android:layout_height="1dp"
                android:background="@color/brand_gold" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/gold_on_dark"
                android:rotation="45" />

            <View
                android:layout_width="90dp"
                android:layout_height="1dp"
                android:background="@color/brand_gold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/welcome_title"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/welcome_body"
            android:textColor="@color/header_on_dark"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center" />

        <!-- The note as a quiet gold-edged card rather than grey small print. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_welcome_note"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/gold_on_dark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/welcome_note"
                android:textColor="@color/header_on_dark"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <!--
          Shown only after a Google account actually connects. It sits on THIS
          screen, above the buttons, because the ledger's first-run walkthrough
          opens over anything shown after this activity finishes — a toast there
          is covered before the owner can read it.
        -->
        <LinearLayout
            android:id="@+id/welcomeSignedIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_signin_confirm"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check_circle"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_signed_in_title"
                    android:textColor="@color/brand_green_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWelcomeSignedInEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!--
          Google's Light "Sign in with Google" pill, per their branding
          guidelines (required for app verification): white fill, 1dp
          #747775 stroke, #1F1F1F Google Sans Medium, the standard-colour G on
          white, sentence case. Their 40px button is scaled to 52dp keeping the
          proportions — G 20px -> 26dp, padding 12 / 10 -> 16 / 13dp. The
          colours are Google's, not the app's: do not restyle this button.
          Labels auto-size so the longest locale stays on one line.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWelcomeConnect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/google_sans_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/welcome_connect"
            android:textAllCaps="false"
            android:textColor="@color/google_btn_text"
            android:textSize="17sp"
            app:autoSizeMaxTextSize="17sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            app:backgroundTint="@color/white"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_google_g"
            app:iconGravity="textStart"
            app:iconPadding="13dp"
            app:iconSize="26dp"
            app:strokeColor="@color/google_btn_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWelcomeSkip"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_skip"
            android:textColor="@color/gold_on_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:rippleColor="@color/welcome_note_stroke" />

    </LinearLayout>

</ScrollView>
