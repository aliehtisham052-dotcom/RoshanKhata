<?xml version="1.0" encoding="utf-8"?>
<!--
  One customer or supplier on Hudhud's answer card (12 Nov 2026): the name, and beside it what he owes or is owed.
  Above TextFit.STACK_SCALE the figure goes under the name (TextFit.stackWhenLarge, lesson 61). Tap: his page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/hudRowNameColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHudRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvHudRowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHudRowFigure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxLines="1"
        android:textColor="@color/brand_green_text"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
