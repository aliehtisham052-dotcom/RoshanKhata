<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:textAlignment="viewStart"
            android:id="@+id/tvFollowUpName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:textAlignment="viewStart"
            android:id="@+id/tvFollowUpAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp" />

        <!-- The customer's own payment rhythm (PaymentHabit); gone when there
             is too little history to have one. -->
        <TextView
            android:textAlignment="viewStart"
            android:id="@+id/tvFollowUpHabit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- "Reminded on …, nothing received since" (PaymentRequest, 29 Oct):
             the last reminder from this phone against his newest payment. -->
        <TextView
            android:textAlignment="viewStart"
            android:id="@+id/tvFollowUpWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/red_gave_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFollowUpAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/red_gave_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- The Message pill (3 Nov 2026): the gold plane is its icon and flies out of it; once WhatsApp
             has opened it reads "Opened today" with a check that draws itself (ui/SendPill). Visual 36dp
             inside a 48dp touch target (MaterialButton's own insets). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvFollowUpSend"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/green_got_text"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_paper_plane_gold"
            app:iconGravity="start"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@null"
            app:strokeColor="@color/green_got_text"
            app:strokeWidth="1.5dp" />

        <!-- No number, no pill: said plainly where the pill would be. -->
        <TextView
            android:id="@+id/tvFollowUpNoPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="150dp"
            android:textAlignment="viewEnd"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
