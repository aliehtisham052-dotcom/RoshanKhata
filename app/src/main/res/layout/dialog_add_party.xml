<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/name"
        android:importantForAutofill="no"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/etPhone"
        android:textDirection="ltr"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/phone_optional"
        android:importantForAutofill="no"
        android:inputType="phone" />

    <!--
      Both optional, and placed after the phone on purpose: a shop with the
      number saved rarely needs either, while a village round needs them more
      than the number. Nothing here blocks Save.
    -->
    <EditText
        android:id="@+id/etFatherName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/father_name_optional"
        android:importantForAutofill="no"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/etVillage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/village_optional"
        android:importantForAutofill="no"
        android:inputType="textCapWords" />

    <!--
      Live heads-up while still typing — the same check that runs again,
      harder, at Save (see confirmDuplicate in KhataActivity). This one is
      quiet and non-blocking: it just gives the owner a chance to notice
      before reaching for Save at all.
    -->
    <TextView
        android:id="@+id/tvAddPartyDuplicateWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/note_bg"
        android:padding="10dp"
        android:textColor="@color/note_text"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Milta-julta customer pehle se maujood: Ali — 0300 1234567"
        xmlns:tools="http://schemas.android.com/tools" />

    <RadioGroup
        android:id="@+id/rgType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/customer" />

        <RadioButton
            android:id="@+id/rbSupplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/supplier" />
    </RadioGroup>

    <!--
      The same box as "Edit details" (2 Oct), so a customer who must not be
      offered WhatsApp can be set from the first day. Customers only: the
      offer is never made to a supplier, so the box hides when Supplier is
      chosen.
    -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbAddNoEntryShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/party_no_entry_share"
        android:textSize="13sp" />

</LinearLayout>
