<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <!--
          Scan bill (1 Oct): read a supplier's printed bill from a photo into
          this form. First on the form, because scanning is how a bill is
          started, not something done after typing it.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBillScan"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/bill_scan"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/section_bills"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <!-- How many product lines this bill already carries (from a scan). -->
        <TextView
            android:textAlignment="viewStart"
            android:id="@+id/tvBillPendingItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/green_got_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!--
          Every product line waiting to go with this bill — scanned or typed —
          each one tappable to change or remove before the bill is saved.
          Filled in code (BillsActivity.renderPendingItems).
        -->
        <LinearLayout
            android:id="@+id/llBillItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <AutoCompleteTextView
            android:popupBackground="@drawable/bg_dropdown_popup"
            android:dropDownVerticalOffset="4dp"
            android:id="@+id/etBillSupplier"
            style="@style/EditorField"
            android:drawableStart="@drawable/ic_truck"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:hint="@string/bill_supplier_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/etBillNumber"
            style="@style/EditorField"
            android:drawableStart="@drawable/ic_hash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/bill_number_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/etBillTotal"
            style="@style/EditorField"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/bill_total_hint"
            android:digits="0123456789.+−×÷*/-%"
            android:importantForAutofill="no"
            android:inputType="phone" />

        <!-- The total is written on the app's calculator pad (21 Oct), shown
             while the total has the focus (CalcPad.bindAll); the running
             total of a sum sits under the box. -->
        <TextView
            android:id="@+id/tvBillTotalResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/brand_green_text"
            android:textDirection="ltr"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <include
            android:id="@+id/billKeypad"
            layout="@layout/view_calculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBillDate"
            style="@style/FormChoiceButton"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="@string/pick_bill_date"
            app:icon="@drawable/ic_calendar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBillDue"
            style="@style/FormChoiceButton"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="@string/bill_due_date"
            app:icon="@drawable/ic_calendar" />

        <!-- Paid outright or on credit (13 Oct): one bordered box with its
             explanation inside, rather than a bare checkbox and fine print. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_editor_field"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <CheckBox
                android:id="@+id/cbPaidCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/bill_paid_cash"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:textAlignment="viewStart"
                android:id="@+id/tvPaidCashHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:text="@string/bill_paid_cash_help"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- What this bill will do to the ledger, stated before it is saved. -->
        <TextView
            android:textAlignment="viewStart"
            android:id="@+id/tvBillLedgerEffect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_note_card"
            android:padding="12dp"
            android:textColor="@color/note_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etBillNote"
            style="@style/EditorField"
            android:drawableStart="@drawable/ic_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/note_optional"
            android:importantForAutofill="no"
            android:inputType="text" />

    </LinearLayout>
</ScrollView>
