<?xml version="1.0" encoding="utf-8"?>
<!--
  The language picker, drawn as one piece of artwork with real buttons on it.

  The picture (lang_screen.webp, 1024 x 1536) carries the logo, the heading and
  the six drawn buttons. It is shown WHOLE: the stage below keeps the picture's
  own shape and sits centred in whatever screen there is, so the artwork is
  never cropped and the touch areas can never drift off the buttons they sit on.
  Every touch area is placed as a percentage of the stage, measured from the
  picture's pixels: columns x 106-361 / 391-639 / 670-921, rows y 731-853 /
  891-1013.

  The line under the heading (y 632-690) is real text, not part of the picture.
  The artwork arrived with an English line printed there; it was painted out,
  because a drawn line cannot be translated. This one is the app's own string,
  in the language the app is currently showing.

  The stage is forced left-to-right. The picture never mirrors, so its touch
  areas must not either: under Urdu, Arabic, Sindhi or Persian the app runs
  right-to-left, ConstraintLayout mirrors start/end and the guidelines, and the
  drawn "Urdu" button would land on the English touch area (Sindhi on Arabic).
  The note line still reads in its own language's direction (textDirection).

  Ids are the ones LanguageActivity has always bound.

  Choosing is two steps (1 Oct): a tap only marks a button (gold ring, the
  selected state of bg_lang_hotspot) and the choice is applied by the Continue
  button below the artwork. The artwork has no room for a full-size button
  under its six (about 5% of its height before the plants and book start), so
  the button sits under the stage and the stage fits whole in the space above
  it. The button's bottom margin takes the navigation bar's height in code.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lang_root">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/langStage"
        android:layoutDirection="ltr"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnLangContinue"
        app:layout_constraintDimensionRatio="1024:1536"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/lang_screen"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/gV1a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.1035" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gV1b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.3525" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gV2a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.3818" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gV2b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.6240" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gV3a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.6543" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gV3b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.8994" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gH1a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.4759" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gH1b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.5553" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gH2a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.5801" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gH2b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.6595" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gH3a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.4115" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gH3b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.4492" />

    <View
        android:id="@+id/langEnglish"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_lang_hotspot"
        android:clickable="true"
        android:contentDescription="English"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/gH1b"
        app:layout_constraintEnd_toEndOf="@id/gV1b"
        app:layout_constraintStart_toStartOf="@id/gV1a"
        app:layout_constraintTop_toTopOf="@id/gH1a" />
    <View
        android:id="@+id/langRomanUrdu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_lang_hotspot"
        android:clickable="true"
        android:contentDescription="Roman Urdu"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/gH1b"
        app:layout_constraintEnd_toEndOf="@id/gV2b"
        app:layout_constraintStart_toStartOf="@id/gV2a"
        app:layout_constraintTop_toTopOf="@id/gH1a" />
    <View
        android:id="@+id/langUrdu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_lang_hotspot"
        android:clickable="true"
        android:contentDescription="اردو"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/gH1b"
        app:layout_constraintEnd_toEndOf="@id/gV3b"
        app:layout_constraintStart_toStartOf="@id/gV3a"
        app:layout_constraintTop_toTopOf="@id/gH1a" />
    <View
        android:id="@+id/langSindhi"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_lang_hotspot"
        android:clickable="true"
        android:contentDescription="سنڌي"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/gH2b"
        app:layout_constraintEnd_toEndOf="@id/gV1b"
        app:layout_constraintStart_toStartOf="@id/gV1a"
        app:layout_constraintTop_toTopOf="@id/gH2a" />
    <View
        android:id="@+id/langPersian"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_lang_hotspot"
        android:clickable="true"
        android:contentDescription="فارسی"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/gH2b"
        app:layout_constraintEnd_toEndOf="@id/gV2b"
        app:layout_constraintStart_toStartOf="@id/gV2a"
        app:layout_constraintTop_toTopOf="@id/gH2a" />
    <View
        android:id="@+id/langArabic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_lang_hotspot"
        android:clickable="true"
        android:contentDescription="العربية"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/gH2b"
        app:layout_constraintEnd_toEndOf="@id/gV3b"
        app:layout_constraintStart_toStartOf="@id/gV3a"
        app:layout_constraintTop_toTopOf="@id/gH2a" />

        <!-- The app's own line, in the app's current language. -->
        <TextView
            android:id="@+id/tvLangNote"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:textDirection="locale"
            android:text="@string/language_change_note"
            android:textColor="#DCE6DF"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="@id/gH3b"
            app:layout_constraintEnd_toEndOf="@id/gV3b"
            app:layout_constraintStart_toStartOf="@id/gV1a"
            app:layout_constraintTop_toTopOf="@id/gH3a" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Applies the marked language. Disabled until one is marked; its label
         is drawn in the marked language (LanguageActivity.mark). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLangContinue"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="20dp"
        android:enabled="false"
        android:fontFamily="@font/google_sans_medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:maxLines="1"
        android:text="@string/continue_action"
        android:textAllCaps="false"
        android:textColor="@color/lang_continue_text"
        android:textSize="17sp"
        app:backgroundTint="@color/lang_continue_fill"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="360dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
