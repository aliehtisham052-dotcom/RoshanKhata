<?xml version="1.0" encoding="utf-8"?>
<!--
  The language picker (9 Oct): the splash's own artwork, continued.

  Two regions, stacked. The artwork region (langStage) takes whatever height
  is left above the panel and shows splash_art.webp - the same painting the
  splash shows, so the first two screens are one picture - anchored by its
  TAGLINE: LanguageActivity scales and places the image so that "Har Hisaab
  Roshan" ends a fixed distance above the panel on every screen, cropping the
  top of the painting on a short screen rather than ever letting the panel
  climb over the words. The last 64dp of the region fade into the page paper
  (bg_lang_fade) so the heading has clean ground.

  The panel (langPanel) is sized by its own content: the heading and note in
  the app's current language, nine real buttons of one size in a 3 x 3 grid
  (bg_lang_button, the paper card the rest of the app is made of; marked, the
  pill turns brand green with a gold ring), Continue, and the maker's line.
  Being real views in a LinearLayout, the buttons take every language, every
  text size and every screen without being placed by hand.

  The grid is forced left-to-right: it is a fixed arrangement, in the order
  the picker has always had, and under Urdu, Arabic, Sindhi or Persian a
  mirrored grid would move every language to the other side of the screen
  from one visit to the next. The heading and note read in their own
  language's direction (textDirection).

  Ids are the ones LanguageActivity has always bound. Choosing is two steps
  (1 Oct): a tap only marks a button and Continue applies the choice; the
  panel's bottom padding takes the navigation bar's height in code.

  Fixed colours by day and by night, like the painting itself.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F6F2">

    <FrameLayout
        android:id="@+id/langStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="true"
        app:layout_constraintBottom_toTopOf="@id/langPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Placed by LanguageActivity.placeArtwork: scaleType matrix. -->
        <ImageView
            android:id="@+id/ivLangArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="matrix"
            android:src="@drawable/splash_art" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_lang_fade" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/langPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="420dp">

        <!-- "Step 1 of 3" and its dots: first run only (LanguageActivity). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/langStepDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLangStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.06"
                android:textColor="#8A6A15"
                android:textDirection="locale"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLangTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:text="@string/select_language"
            android:textColor="#0F4A33"
            android:textDirection="locale"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- The app's own line, in the app's current language. -->
        <TextView
            android:id="@+id/tvLangNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/language_change_note"
            android:textColor="#3E6B55"
            android:textDirection="locale"
            android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginTop="0dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/langEnglish"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_lang_button"
            android:clickable="true"
            android:contentDescription="English"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="@drawable/bg_lang_button_ring"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="English"
            android:textColor="@color/lang_button_text"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/langRomanUrdu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_lang_button"
            android:clickable="true"
            android:contentDescription="Roman Urdu"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="@drawable/bg_lang_button_ring"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="Roman Urdu"
            android:textColor="@color/lang_button_text"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/langUrdu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_lang_button"
            android:clickable="true"
            android:contentDescription="اردو"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="@drawable/bg_lang_button_ring"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="اردو"
            android:textColor="@color/lang_button_text"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/langSindhi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_lang_button"
            android:clickable="true"
            android:contentDescription="سنڌي"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="@drawable/bg_lang_button_ring"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="سنڌي"
            android:textColor="@color/lang_button_text"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/langPersian"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_lang_button"
            android:clickable="true"
            android:contentDescription="فارسی"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="@drawable/bg_lang_button_ring"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="فارسی"
            android:textColor="@color/lang_button_text"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/langArabic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_lang_button"
            android:clickable="true"
            android:contentDescription="العربية"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="@drawable/bg_lang_button_ring"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="العربية"
            android:textColor="@color/lang_button_text"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/langHindi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_lang_button"
            android:clickable="true"
            android:contentDescription="हिन्दी"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="@drawable/bg_lang_button_ring"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="हिन्दी"
            android:textColor="@color/lang_button_text"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/langBengali"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_lang_button"
            android:clickable="true"
            android:contentDescription="বাংলা"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="@drawable/bg_lang_button_ring"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="বাংলা"
            android:textColor="@color/lang_button_text"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/langIndonesian"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_lang_button"
            android:clickable="true"
            android:contentDescription="Indonesia"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="@drawable/bg_lang_button_ring"
            android:fontFamily="@font/google_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="Indonesia"
            android:textColor="@color/lang_button_text"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

        <!-- Applies the marked language. Disabled until one is marked; its label
             is drawn in the marked language (LanguageActivity.mark). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLangContinue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:fontFamily="@font/google_sans_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:text="@string/continue_action"
            android:textAllCaps="false"
            android:textColor="@color/lang_continue_text"
            android:textSize="15.5sp"
            app:backgroundTint="@color/lang_continue_fill"
            app:cornerRadius="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="@string/powered_by"
            android:textColor="#3E6B55"
            android:textSize="10.5sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
