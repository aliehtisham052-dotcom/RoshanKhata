<?xml version="1.0" encoding="utf-8"?>
<!--
  The language page (5 Nov 2026, the owner's approved setup mockup; the 9 Oct page carried the
  splash's painting over a 3 x 3 grid of names).

  A compact brand band (the app's own icon, its name, "Har Hisaab Roshan"), the step and the
  question, then the nine languages as a list: each row the language's own name in its own
  script, its name in the app's language under it, the phone's own language tagged, and a radio
  (item_language_row, filled by LanguageActivity). The list scrolls; Continue stays in sight.

  The rows follow the app's direction (an Urdu page reads from the right), each name aligned to
  its row's start (lesson 61). Night-aware like the setup's other two pages. Ids are the ones
  LanguageActivity and the tests have always used; choosing is two steps (a tap marks, Continue
  applies).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/langRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/langHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_light"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:importantForAccessibility="no"
            android:src="@drawable/splash_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_medium"
            android:text="@string/app_name"
            android:textColor="@color/header_light_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/playfair_display_variable"
            android:text="@string/brand_tagline"
            android:textColor="@color/gold_accent"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <!-- "Step 1 of 3" and its dots: during the setup only (LanguageActivity). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/langStepDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLangStep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.1"
                android:textAlignment="viewStart"
                android:textAllCaps="true"
                android:textColor="@color/gold_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLangTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/select_language"
            android:textAlignment="viewStart"
            android:textColor="@color/header_light_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLangNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/language_change_note"
            android:textAlignment="viewStart"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/langScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="16dp"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:id="@+id/langList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <include
                android:id="@+id/langEnglish"
                layout="@layout/item_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/langRomanUrdu"
                layout="@layout/item_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/langUrdu"
                layout="@layout/item_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/langSindhi"
                layout="@layout/item_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/langPersian"
                layout="@layout/item_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/langArabic"
                layout="@layout/item_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/langHindi"
                layout="@layout/item_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/langBengali"
                layout="@layout/item_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/langIndonesian"
                layout="@layout/item_language_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>

    <!-- Continue and the maker's line; the bottom padding takes the navigation bar's height in code. -->
    <LinearLayout
        android:id="@+id/langPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/page_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <!-- Applies the marked language. Disabled until one is marked; its label
             is drawn in the marked language (LanguageActivity.mark). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLangContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="52dp"
            android:fontFamily="@font/google_sans_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:text="@string/continue_action"
            android:textAllCaps="false"
            android:textColor="@color/trade_continue_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/trade_continue_fill"
            app:cornerRadius="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="@string/powered_by"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
