<?xml version="1.0" encoding="utf-8"?>
<!-- Galla milan: the books' figure, the counted figure, the difference.
     Both figures are written on the app's calculator pad (21 Oct). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <!-- Which stretch these figures cover (2 Nov 2026): since the last count, with its day and
             time, or — the first time — today from the start of the day. -->
        <TextView
            android:id="@+id/tvSince"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textAlignment="viewStart"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOpeningLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/etOpening"
            android:text="@string/dayclose_opening"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <EditText
            style="@style/EditorField"
            android:layout_marginTop="4dp"
            android:id="@+id/etOpening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789.+−×÷*/-%"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:textAlignment="viewStart"
            android:textDirection="ltr" />

        <TextView
            android:id="@+id/tvOpeningResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/brand_green_text"
            android:textDirection="ltr"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- The books' sum as a small table: each line's words at the start, its figure at the end,
             the total under a rule (CashbookActivity.breakdownRows). -->
        <LinearLayout
            android:id="@+id/breakdownRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_editor_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/etCounted"
            android:text="@string/dayclose_counted"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <EditText
            style="@style/EditorField"
            android:layout_marginTop="4dp"
            android:id="@+id/etCounted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789.+−×÷*/-%"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:textAlignment="viewStart"
            android:textDirection="ltr" />

        <TextView
            android:id="@+id/tvCountedResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/brand_green_text"
            android:textDirection="ltr"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Shown once a count is typed: matches (green), short (red), more than the books (amber). -->
        <TextView
            android:textAlignment="viewStart"
            android:id="@+id/tvDifference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- One pad for both figures: it types into whichever of the two
             has the focus, and steps aside for the note (CalcPad.bindAll). -->
        <include
            android:id="@+id/closeKeypad"
            layout="@layout/view_calculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <EditText
            style="@style/EditorField"
            android:id="@+id/etCloseNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/dayclose_note_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <TextView
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/dayclose_help"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
