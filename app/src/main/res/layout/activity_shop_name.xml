<?xml version="1.0" encoding="utf-8"?>
<!--
  First run, step 3 of 3: the shop's details (11 Oct; redrawn 5 Nov 2026 from the owner's
  approved setup mockup). The name, the country and the phone on one page, under a picture of
  the invoice's band that fills in as they are typed - the reason the page asks at all.

  The country is a box here, filled with what the phone names (SIM, network, the phone's own
  languages) and changed on its own page (ui/CountryPicker); it was a sheet that opened by
  itself after the name, and Back on it kept the guess and went straight to Home. The phone
  box carries the country's calling code in front of it, left to right in every language.

  Back (the arrow, or the phone's) goes to step 2 keeping what is typed; "Start my khata" needs
  the name; "Maybe later" goes on without it. The same light header as the shop-type page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shopNameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_light"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnShopNameBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/header_light_ink" />

            <LinearLayout
                android:id="@+id/nameStepDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:layoutDirection="ltr"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvNameKicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.1"
                android:textAlignment="viewStart"
                android:textAllCaps="true"
                android:textColor="@color/gold_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:text="@string/shop_details_title"
            android:textAlignment="viewStart"
            android:textColor="@color/header_light_ink"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/shop_add_name_sub"
            android:textAlignment="viewStart"
            android:textColor="@color/header_light_ink_soft"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- The invoice's band as these details will print it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_trade_card"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:letterSpacing="0.08"
                    android:text="@string/shop_preview_label"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/text_muted"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_setup_preview_band"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:id="@+id/tvPreviewName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAlignment="viewStart"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Al-Noor Traders" />

                    <TextView
                        android:id="@+id/tvPreviewLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAlignment="viewStart"
                        android:textColor="#D6E8DC"
                        android:textSize="12.5sp"
                        tools:text="+92 300 1234567 · Pakistan" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/tvPreviewDoc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        tools:text="INVOICE · INV-000001" />

                    <TextView
                        android:id="@+id/tvPreviewDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        tools:text="5 Nov 2026" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@+id/etShopName"
                android:text="@string/shop_name_field"
                android:textAlignment="viewStart"
                android:textColor="@color/brand_green_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etShopName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_editor_field"
                android:hint="@string/shop_name_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLength="60"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textColorHint="@color/hint_pale"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvCountryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/bp_country"
                android:textAlignment="viewStart"
                android:textColor="@color/brand_green_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnShopCountry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_editor_field"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvShopFlag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:textSize="22sp"
                    tools:ignore="SpUsage"
                    tools:text="PK" />

                <TextView
                    android:id="@+id/tvShopCountry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Pakistan" />

                <TextView
                    android:id="@+id/tvShopCountryCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp"
                    tools:text="+92 · Rs" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvShopCountryHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textAlignment="viewStart"
                android:textColor="@color/ink_soft"
                android:textSize="12.5sp"
                tools:text="Found from your phone. Tap to change." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@+id/etShopPhone"
                android:text="@string/shop_phone_field"
                android:textAlignment="viewStart"
                android:textColor="@color/brand_green_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Left to right in every language, as a phone number is: the calling code, then the number. -->
            <LinearLayout
                android:id="@+id/shopPhoneBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_editor_field"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:minHeight="52dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvShopPhonePrefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="+92" />

                <View
                    android:id="@+id/shopPhoneRule"
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:background="@color/page_line" />

                <EditText
                    android:id="@+id/etShopPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="20"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/ink"
                    android:textDirection="ltr"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- What Hudhud calls the owner (13 Nov 2026, the owner: "Hudhud mujhe naam se bulaye"): kept on this
                 phone only (HudhudPrefs), never in the book; may be left empty. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@+id/etOwnerName"
                android:text="@string/hudhud_call_me"
                android:textAlignment="viewStart"
                android:textColor="@color/brand_green_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOwnerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_editor_field"
                android:hint="@string/hudhud_call_me_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="30"
                android:minHeight="52dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAlignment="viewStart"
                android:textColor="@color/ink"
                android:textColorHint="@color/hint_pale"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/shopNameFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShopNameContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="54dp"
            android:text="@string/setup_start"
            android:textAllCaps="false"
            android:textColor="@color/trade_continue_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/trade_continue_fill"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShopNameLater"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="48dp"
            android:text="@string/welcome_skip"
            android:textAllCaps="false"
            android:textColor="@color/brand_green_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
