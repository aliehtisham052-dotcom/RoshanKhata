<?xml version="1.0" encoding="utf-8"?>
<!--
  Every box is asked by a label ABOVE it, not by a hint inside it (30 Oct 2026, the owner's photo:
  "Barcode (optional", "Cost price (op", "How many in a" — a hint is drawn on one line and cut at
  the box's edge, and the paired boxes are half the dialog wide). A label wraps and is read whole
  in every language and at every text size; the unit's examples change with the shop's trade
  (TradeVocab), so its label is written in code. In a pair, each box sits at the foot of its
  column, so the two boxes stay level when one label takes two lines.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvGuessNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_guess_note"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvProductNameLabel"
            style="@style/FormFieldLabel"
            android:layout_marginTop="0dp"
            android:labelFor="@+id/etProductName"
            android:text="@string/product_name" />

        <EditText
            style="@style/EditorField"
            android:layout_marginTop="4dp"
            android:id="@+id/etProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <TextView
            android:id="@+id/tvProductCompanyLabel"
            style="@style/FormFieldLabel"
            android:layout_marginTop="10dp"
            android:labelFor="@+id/etProductCompany"
            android:text="@string/company_optional" />

        <EditText
            style="@style/EditorField"
            android:layout_marginTop="4dp"
            android:id="@+id/etProductCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <!-- Category is not asked: it asked what "Type" below asks. The column stays and keeps what it holds. -->

        <TextView
            android:id="@+id/tvProductUnitLabel"
            style="@style/FormFieldLabel"
            android:layout_marginTop="10dp"
            android:labelFor="@+id/etProductUnit"
            android:text="@string/unit_optional" />

        <EditText
            style="@style/EditorField"
            android:layout_marginTop="4dp"
            android:id="@+id/etProductUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text" />

        <!-- The two rates: paid today, and paid after the crop. Both optional; zero is a price, empty is none. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                android:id="@+id/tvSalePriceLabel"
                style="@style/FormFieldLabel"
                android:layout_marginTop="0dp"
                android:labelFor="@+id/etSalePrice"
                android:text="@string/sale_price_hint" />

                <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etSalePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                android:id="@+id/tvCreditPriceLabel"
                style="@style/FormFieldLabel"
                android:layout_marginTop="0dp"
                android:labelFor="@+id/etCreditPrice"
                android:text="@string/credit_price_hint" />

                <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etCreditPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/product_price_help"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <!-- The counter (POS Phase 2): the pack's barcode (the camera reads it), what the unit costs the
             shop, and the stock level that warns. -->
        <TextView
            android:id="@+id/tvBarcodeLabel"
            style="@style/FormFieldLabel"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/etBarcode"
            android:text="@string/product_barcode_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                style="@style/EditorField"
                android:id="@+id/etBarcode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword" />

            <!-- The app's own outlined button (MaterialComponents): the Material 3 style this had found
                 none of its colours in the app's theme and drew a magenta edge and tiny text. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanBarcode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxWidth="140dp"
                android:minHeight="48dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/pos_scan"
                android:textAllCaps="false"
                android:textColor="@color/brand_green_text"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_qr_scan"
                app:iconTint="@color/brand_green_text"
                app:strokeColor="@color/page_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                android:id="@+id/tvCostPriceLabel"
                style="@style/FormFieldLabel"
                android:layout_marginTop="0dp"
                android:labelFor="@+id/etCostPrice"
                android:text="@string/product_cost_hint" />

                <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etCostPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                android:id="@+id/tvLowStockLabel"
                style="@style/FormFieldLabel"
                android:layout_marginTop="0dp"
                android:labelFor="@+id/etLowStock"
                android:text="@string/product_low_stock_hint" />

                <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etLowStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Packs and tax (schema 36): a bigger unit the product also comes or goes in, and its tax. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/product_pack_help"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                android:id="@+id/tvPackUnitLabel"
                style="@style/FormFieldLabel"
                android:layout_marginTop="0dp"
                android:labelFor="@+id/etPackUnit"
                android:text="@string/product_pack_unit" />

                <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etPackUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                android:id="@+id/tvPackSizeLabel"
                style="@style/FormFieldLabel"
                android:layout_marginTop="0dp"
                android:labelFor="@+id/etPackSize"
                android:text="@string/product_pack_size" />

                <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etPackSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                android:id="@+id/tvPackPriceLabel"
                style="@style/FormFieldLabel"
                android:layout_marginTop="0dp"
                android:labelFor="@+id/etPackPrice"
                android:text="@string/product_pack_price" />

                <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etPackPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                android:id="@+id/tvTaxRateLabel"
                style="@style/FormFieldLabel"
                android:layout_marginTop="0dp"
                android:labelFor="@+id/etTaxRate"
                android:text="@string/product_tax_rate" />

                <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etTaxRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Variants (21 Oct 2026): this product as one size, colour or flavour of a main product. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/product_variant_help"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvVariantOfLabel"
            style="@style/FormFieldLabel"
            android:layout_marginTop="10dp"
            android:labelFor="@+id/etVariantOf"
            android:text="@string/product_variant_of" />

        <AutoCompleteTextView
            style="@style/EditorField"
            android:layout_marginTop="4dp"
            android:id="@+id/etVariantOf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:dropDownVerticalOffset="4dp"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:popupBackground="@drawable/bg_dropdown_popup" />

        <TextView
            android:id="@+id/tvVariantLabel"
            style="@style/FormFieldLabel"
            android:layout_marginTop="10dp"
            android:labelFor="@+id/etVariant"
            android:text="@string/product_variant" />

        <EditText
            style="@style/EditorField"
            android:layout_marginTop="4dp"
            android:id="@+id/etVariant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <!-- The product type is every trade's (its list is the trade's own).
             The inspection details below are only for the trades an
             inspector visits - agriculture and medical - and
             ProductDetailsDialog hides the whole group for any other (9 Oct). -->
        <TextView
            android:id="@+id/tvProductTypeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:labelFor="@+id/etProductType"
            android:text="@string/product_type_hint"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <!-- An AutoCompleteTextView (9 Oct): the trade's own types drop down,
             and the owner may still type a type of his own. -->
        <AutoCompleteTextView
            style="@style/EditorField"
            android:layout_marginTop="4dp"
            android:popupBackground="@drawable/bg_dropdown_popup"
            android:dropDownVerticalOffset="4dp"
            android:id="@+id/etProductType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />


        <LinearLayout
            android:id="@+id/complianceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/divider_grey" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/compliance_section"
                android:textColor="@color/brand_green_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:id="@+id/tvComplianceExplain"
                android:text="@string/compliance_explain"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:id="@+id/tvTechnicalLabel"
                android:labelFor="@+id/etTechnicalName"
                android:text="@string/technical_name_hint"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etTechnicalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:id="@+id/tvFormulationLabel"
                android:labelFor="@+id/etFormulation"
                android:text="@string/formulation_hint"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etFormulation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:id="@+id/tvRegistrationLabel"
                android:labelFor="@+id/etRegistrationNumber"
                android:text="@string/registration_number_hint"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <EditText
                style="@style/EditorField"
                android:layout_marginTop="4dp"
                android:id="@+id/etRegistrationNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
