<?xml version="1.0" encoding="utf-8"?>
<!--
  Editing a product, which until now could not be edited at all: products are
  created by typing a name into a bill, and whatever was typed was what the
  product stayed. The compliance block is the reason this screen exists, but
  the plain fields belong here too — a name entered in a hurry mid-sale should
  be fixable afterwards.

  Everything below the name is optional and says so. A feed or seed shop must
  never be made to answer pesticide questions to save a product.

  The four Agriculture Department questions are asked ABOVE their boxes, not
  inside them. A hint lives on one line and is cut off when it runs past the
  edge, and these four run well past it: "Active ingredient, e.g.
  Chlorpyrifos 40% EC" arrived on screen as "Active ingredient, e.g. Chlorpy"
  with no way to see the rest — the owner could not tell what was being asked
  for, and the example, which is the part that actually answers the question,
  was the part that vanished. As a label the same string wraps and is read in
  full. Urdu, Arabic, Sindhi and Persian run longer than English, so this was
  worse in the languages most of these shops read.

  The strings themselves are untouched, which is the point: all six locales
  already have them, and nothing needed retranslating to fix this. The three
  short fields above keep their hints, which fit.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="440dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/product_name"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etProductCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/company_optional"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <!--
          Category was removed here, not renamed. It asked for the same thing
          as "Type" in the Agriculture Department block below — both were
          documented in Product.kt as "pesticide, seed, fertiliser, feed" —
          so the form asked one question twice and the owner could not tell
          which box wanted what. Type is the one kept: it sits with the
          registration fields it belongs to and it already travels with the
          register's own query. The products.category COLUMN stays, and what
          is already stored in it is preserved on save, so no backup written
          before today loses anything.
        -->

        <EditText
            android:id="@+id/etProductUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/unit_optional"
            android:importantForAutofill="no"
            android:inputType="text" />

        <!--
          The two rates, side by side because they are the same figure asked
          twice: what this costs paid today, and what it costs paid after the
          crop. Both optional — a shop that quotes from memory fills in
          neither and loses nothing.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSalePrice"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/sale_price_hint"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etCreditPrice"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/credit_price_hint"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/product_price_help"
            android:textColor="@color/ink_soft"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/divider_grey" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/compliance_section"
            android:textColor="@color/brand_green_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/compliance_explain"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:labelFor="@+id/etProductType"
            android:text="@string/product_type_hint"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etProductType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:labelFor="@+id/etTechnicalName"
            android:text="@string/technical_name_hint"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etTechnicalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:labelFor="@+id/etFormulation"
            android:text="@string/formulation_hint"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etFormulation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:labelFor="@+id/etRegistrationNumber"
            android:text="@string/registration_number_hint"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etRegistrationNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text" />

    </LinearLayout>

</ScrollView>
