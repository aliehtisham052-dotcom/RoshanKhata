<?xml version="1.0" encoding="utf-8"?>
<!--
  The "Open" badge in the business list.

  Its own shape, because the header's bg_business_logo cannot do this job:
  that one is translucent white, which only shows up because the header
  behind it is dark green. Laid on the list's near-white page it is white on
  white — a pill with no pill, and gold text with nothing to sit against.

  Filled with the same green as the header instead, so the badge reads at a
  glance and still belongs to the app's own palette.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/section_khata" />
    <corners android:radius="11dp" />
</shape>
