<?xml version="1.0" encoding="utf-8"?>
<!-- One customer in the Khata list: a white rounded card. Selection tints the
     whole card (PartyAdapter sets backgroundTintList). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/white" />
    <stroke android:width="1dp" android:color="@color/page_line" />
    <corners android:radius="16dp" />
</shape>
