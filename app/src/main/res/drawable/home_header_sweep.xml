<?xml version="1.0" encoding="utf-8"?>
<!--
  Three gold rings cut off by the header's top corner — the gold-sweep idea
  of the welcome screen, drawn as outlines so it decorates without competing
  with the balance. The vector clips to its own box, so only the arcs inside
  it show. Three rings and a 2-unit stroke (7 Oct) where there were two at
  1.5: on the phone the pair all but vanished.

  autoMirrored: the circles run off the box's right side, which is the screen
  edge only in left-to-right languages; under Urdu, Arabic, Sindhi and Persian
  the box sits at the left and, mirrored, they run off the left edge the same
  way.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="180dp" android:height="150dp"
    android:autoMirrored="true"
    android:viewportWidth="180" android:viewportHeight="150">
    <path android:strokeColor="@color/home_header_sweep" android:strokeWidth="2"
        android:pathData="M50,10a100,100 0 1,0 200,0a100,100 0 1,0 -200,0" />
    <path android:strokeColor="@color/home_header_sweep" android:strokeWidth="2"
        android:pathData="M85,15a70,70 0 1,0 140,0a70,70 0 1,0 -140,0" />
    <path android:strokeColor="@color/home_header_sweep" android:strokeWidth="2"
        android:pathData="M115,20a42,42 0 1,0 84,0a42,42 0 1,0 -84,0" />
</vector>
