<?xml version="1.0" encoding="utf-8"?>
<!-- A verse on his card: a quiet panel with a gold line at its start edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hudhud_verse_bg" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:gravity="start" android:width="3dp" android:top="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_accent" />
        </shape>
    </item>
</layer-list>
