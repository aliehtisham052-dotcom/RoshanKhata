<?xml version="1.0" encoding="utf-8"?>
<!-- A soft note card on the page (Supplier Bills, Products, 13 Oct): the
     note's own warm fill, rounded like the cards around it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/note_bg" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/hairline" />
</shape>
