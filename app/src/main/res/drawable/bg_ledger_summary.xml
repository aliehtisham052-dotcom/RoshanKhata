<?xml version="1.0" encoding="utf-8"?>
<!--
  The two totals on the Khata sheet (7 Oct): paper cards with a hairline
  edge, the arrow chip and the figure carrying the colour — the same card as
  the Home header's pair, so the two screens read as one app. Replaces the
  flat pink and mint boxes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke android:width="1dp" android:color="@color/page_line" />
    <corners android:radius="12dp" />
</shape>
