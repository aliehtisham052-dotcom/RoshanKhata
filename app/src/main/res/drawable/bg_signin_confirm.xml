<!--
  The soft-green pill behind the sign-in confirmation. Same fill the status
  strips on white cards use, with a stroke in the brand green so the banner
  reads as a deliberate confirmation rather than a tinted block of text.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand_green_soft" />
    <stroke
        android:width="1dp"
        android:color="@color/brand_green" />
    <corners android:radius="12dp" />
</shape>
