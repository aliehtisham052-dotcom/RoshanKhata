<?xml version="1.0" encoding="utf-8"?>
<!--
  "Hisaab saaf" (2 Oct): a ring, then a tick drawn in, ~800 ms. Android's own
  AnimatedVectorDrawable — no library, a few hundred bytes. Abstract shapes
  only (no living figures).
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="96dp"
            android:height="96dp"
            android:viewportWidth="48"
            android:viewportHeight="48">
            <path
                android:name="ring"
                android:pathData="M24,4 A20,20 0 1,1 23.99,4"
                android:strokeColor="@color/settled_green"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <path
                android:name="tick"
                android:pathData="M15,25 L21,31 L34,18"
                android:strokeColor="@color/settled_green"
                android:strokeWidth="4"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:trimPathEnd="0" />
        </vector>
    </aapt:attr>
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="tick">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="350"
                android:startOffset="400"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
