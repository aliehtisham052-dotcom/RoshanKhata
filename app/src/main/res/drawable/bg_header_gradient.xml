<?xml version="1.0" encoding="utf-8"?>
<!--
  The header behind the balance (Home, Khata, Business settings).

  Brand green running into the logo's deep green, left to right. The three
  stops live in colors.xml (header_grad_*), where the contrast figures are.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/header_grad_start"
        android:centerColor="@color/header_grad_mid"
        android:endColor="@color/header_grad_end"
        android:type="linear" />
</shape>
