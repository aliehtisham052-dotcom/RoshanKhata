<?xml version="1.0" encoding="utf-8"?>
<!--
  The Khata header: green for a fixed 145dp from the TOP, page colour below
  that, so the white card at the foot of the header sits half on the green
  and half on the page, the way the entry screen's card does.

  This used to be "green stops 64dp short of the BOTTOM" instead. That bottom
  edge moves with khataCard's own height — the voice strip alone adds real
  height below it — so the fixed 64dp inset drifted wherever khataCard's
  height put it, most of the time landing partway UP the card and cutting a
  hard line across it instead of staying under its top edge. 145dp covers the
  business row, the balance row, khataCard's 8dp gap, and enough of the card's
  own top padding to stay hidden behind its rounded corner; it does not reach
  the card's shortest possible bottom edge (its own content and padding alone
  run past 170dp), so the seam stays hidden under the card no matter which
  rows below are visible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/page_bg" />
    <item android:height="145dp" android:gravity="top" android:drawable="@drawable/bg_header_gradient" />
</layer-list>
