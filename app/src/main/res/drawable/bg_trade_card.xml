<?xml version="1.0" encoding="utf-8"?>
<!-- A trade card on the picker (9 Oct): white with a hairline; chosen, a 2dp
     brand-green ring on a faint green fill. Driven by the card's selected state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/brand_green_soft" />
            <stroke android:width="2dp" android:color="@color/brand_green_text" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/page_line" />
        </shape>
    </item>
</selector>
