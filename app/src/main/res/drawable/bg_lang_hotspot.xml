<?xml version="1.0" encoding="utf-8"?>
<!--
  The touch feedback for a language button that is drawn in the artwork: a
  green ripple, clipped to a rounded rectangle the size of the drawn button so
  the press reads as pressing that button and not a square laid over it.

  Selected (the language marked but not yet applied): a bright gold ring on
  the drawn button's edge. Nothing is drawn otherwise, so the artwork shows
  as it is.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3300663A">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="3dp" android:color="@color/gold_on_dark" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
