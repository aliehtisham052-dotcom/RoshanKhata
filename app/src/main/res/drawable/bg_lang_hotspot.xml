<?xml version="1.0" encoding="utf-8"?>
<!--
  The touch feedback for a language button that is drawn in the artwork: a
  green ripple, clipped to a rounded rectangle the size of the drawn button so
  the press reads as pressing that button and not a square laid over it.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3300663A">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
