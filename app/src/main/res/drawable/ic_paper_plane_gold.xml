<?xml version="1.0" encoding="utf-8"?>
<!--
  The golden paper plane (3 Nov 2026, the owner: "professional karo"; the first, flat one was 5 Oct).
  A folded plane in three faces - the near wing light, the far wing deeper, the keel in shadow - with
  the fold line catching the light. Its nose points 43.5 degrees above the +x axis (Motion's NOSE).
  It is the Message button's icon on Follow-up, and the plane that flies off when a reminder goes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <path android:pathData="M21,27 L44,5 L31,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="21"
                android:startY="5"
                android:endX="21"
                android:endY="44"
                android:startColor="#FFD9A62E"
                android:endColor="#FFB98A1C" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FF7C5E12"
        android:pathData="M21,27 L27,33 L23.5,41 Z" />
    <path android:pathData="M4,22 L44,5 L21,27 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="5"
                android:endX="44"
                android:endY="27"
                android:startColor="#FFFBE08A"
                android:endColor="#FFE8B83F" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M21,27 L44,5"
        android:strokeWidth="0.9"
        android:strokeColor="#CCFFF6D6"
        android:strokeLineCap="round" />
</vector>
