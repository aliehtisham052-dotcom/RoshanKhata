    <item>
        <shape android:shape="oval">
            <solid android:color="#331B5E3A" />
        </shape>
    </item>
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/brand_green" />
        </shape>
    </item>
</layer-list>
