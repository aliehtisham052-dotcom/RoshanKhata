<?xml version="1.0" encoding="utf-8"?>
<!-- A plain white card with a hairline border, used to group one profile
     section (Business, Seals & signatures, Statement options, Payment & tax)
     so the screen reads as a set of tidy cards rather than one long form. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/white" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/hairline" />
</shape>
