<?xml version="1.0" encoding="utf-8"?>
<!--
  The inline voice confirmation, sitting on the dark header.

  Paper rather than a tint of the header, because the figure inside is money
  and has to read as plainly as it does in the list below. The gold edge is
  the same one the mic button carries, so the strip reads as that button's
  answer rather than as a new part of the screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/navy_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/gold_on_dark" />
    <corners android:radius="10dp" />
</shape>
