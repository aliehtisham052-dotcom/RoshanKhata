<?xml version="1.0" encoding="utf-8"?>
<!--
  A language button on the language screen (9 Oct): a paper-white pill with
  the app's own hairline, the same card the Home and Khata screens are made
  of, over the splash artwork. Marked, the pill itself turns brand green
  (lang_button_face / lang_button_edge are state lists, so the one shape
  carries both states and the on-device contrast check reads the colour the
  label really sits on). The gold ring of the mark is bg_lang_button_ring,
  laid on as the foreground.

  Fixed colours on purpose: the artwork is the same by day and by night, so
  this button must be too.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2E1B5E3A">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lang_button_face" />
            <stroke android:width="1dp" android:color="@color/lang_button_edge" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</ripple>
