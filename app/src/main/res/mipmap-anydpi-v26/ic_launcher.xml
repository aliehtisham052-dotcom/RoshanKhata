<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon on Android 8 and up.

  The system masks these two layers to whatever shape the phone uses: a
  squircle on most Samsung, Oppo, Vivo, Infinix and Xiaomi phones, a circle on
  a Pixel. The logo tile is drawn at 70dp of the 108dp layer, just inside the
  72dp that any mask shows, so on a squircle its whole gold rim is visible and
  on a circle only the rim's four corners fall outside. Behind it the
  background layer is the tile's own green, so whatever the mask shows beyond
  the rim is more of the tile and never a coloured plate.

  Both variants were rendered under both mask shapes before this was chosen;
  the other candidate, the tile on the old cream at 66dp, read as a sticker on
  a plate.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
