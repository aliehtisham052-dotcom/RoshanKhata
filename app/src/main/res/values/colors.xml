<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Roshan Khata — "Ink & Paper".

      A shopkeeper reads this standing in the sun, on a cheap screen, often in
      a hurry. Dark text on a pale ground is what survives that. The navy header
      looked handsome indoors and washed out on a shop counter at two in the
      afternoon.

      The NAMES are deliberately unchanged. Twenty-odd layouts reference
      @color/navy_primary and @color/gold_accent; renaming them would mean
      touching every one of those files and inviting a mistake in each. Only the
      values move. The whole app re-themes at once, and nothing breaks.
    -->

    <!-- Surfaces: what was navy is now paper -->
    <color name="navy_deep">#EFEDE5</color>
    <color name="navy_primary">#1B5E3A</color>  <!-- was #FFFFFF: only ever used as a heading text colour, so it must be dark to read on pale screens -->
    <color name="navy_surface">#FAF9F5</color>

    <!--
      Gold, darkened until it is legible AS TEXT.

      The old #D4A438 was a fill colour pressed into service as a label, and on
      white it barely registers. This is the same gold taken down to where it
      actually reads. Money is not the place to be subtle.
    -->
    <color name="gold_accent">#8A6A15</color>
    <color name="gold_bright">#8A6A15</color>

    <!-- The page beneath the cards -->
    <color name="page_bg">#F7F6F2</color>
    <color name="page_line">#E5E3DC</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#1A1A18</color>
    <color name="text_muted">#6B6B66</color>

    <!--
      Ledger direction. Both darkened for the pale ground.

      These two carry the most important meaning in the app — who owes whom —
      and they now sit on white rather than navy, where the old shades would be
      too light to be sure of. Anyone who cannot easily tell red from green still
      has the label beneath the number.
    -->
    <color name="red_gave">#A32D2D</color>
    <color name="green_got">#0F6E56</color>

    <!--
      Bright variants for red_gave/green_got ON a dark-green header.

      The report screen's totals bar sits on section_khata, and the plain
      colours above were never meant for that — green_got measured 1.25:1
      against it, red_gave 1.1:1, both far under the 4.5:1 a shopkeeper
      needs in daylight. These two exist only for that bar.
    -->
    <color name="red_gave_on_dark">#FFB3AB</color>
    <color name="green_got_on_dark">#7FE3C4</color>

    <!-- Ink: text on paper -->
    <color name="ink">#1A1A18</color>
    <color name="ink_soft">#5F5E5A</color>

    <!--
      Section colours.

      Each screen gets its own header so the owner knows where they are at a
      glance — a shopkeeper mid-transaction should not have to read a title to
      tell the Cashbook from the cheque register.

      Every one of these was chosen to carry WHITE text at 7:1 or better. A
      header that looks handsome and cannot be read is worse than a plain one.
      The list beneath stays paper, so the numbers — which are the point — keep
      the contrast they need.
    -->
    <color name="section_khata">#1B5E3A</color>
    <color name="section_khata_soft">#B8D0C0</color>

    <color name="section_cashbook">#0E5236</color>
    <color name="section_cashbook_soft">#9FCBB0</color>

    <color name="section_cheques">#12564E</color>
    <color name="section_cheques_soft">#9FC9C0</color>

    <color name="section_plans">#3E5B2A</color>
    <color name="section_plans_soft">#C3D4A8</color>

    <color name="section_bills">#5C4A16</color>
    <color name="section_bills_soft">#E0D2A0</color>

    <color name="section_tools">#374A40</color>
    <color name="section_tools_soft">#A6BBAC</color>

    <!--
      Brand colours, taken from the logo.

      The deep green of the book and the gold of the R. These are the identity
      the owner chose; the section colours below are tuned to sit in the same
      family so the app reads as one thing rather than a row of unrelated
      headers.
    -->
    <color name="brand_green">#1B5E3A</color>
    <color name="brand_green_soft">#E7F2EA</color>  <!-- status strip fill on white cards -->
    <color name="brand_green_dark">#134228</color>
    <color name="brand_gold">#D4A02A</color>
    <color name="gold_on_dark">#FFDA6B</color>  <!-- bright gold for text/borders ON the dark green header -->
    <color name="brand_gold_soft">#A9C4B0</color>
    <!-- 8% white over the green header: lifts a tile off the header while
         gold_on_dark still measures 4.68:1 on it (10% would drop to 4.46) -->
    <color name="header_tile_fill">#14FFFFFF</color>

    <!--
      Welcome screen. welcome_bg is the green the language-screen logo sits on,
      so logo_on_green blends into it without a box; welcome_band is the darker
      green under the gold sweeps, as on the splash and language artwork.
    -->
    <color name="welcome_bg">#0A4726</color>
    <color name="welcome_band">#06391E</color>
    <color name="welcome_note_fill">#0FFFFFFF</color>
    <color name="welcome_note_stroke">#66FFDA6B</color>

    <!--
      Google's own Light button, fixed by the Sign in with Google branding
      guidelines (checked 22 Sep 2026, page updated 7 Jul 2026): fill #FFFFFF,
      1px inside stroke #747775, text #1F1F1F. Not brand colours — do not
      restyle them; the standard-colour G may only sit on this white.
    -->
    <color name="google_btn_stroke">#747775</color>
    <color name="google_btn_text">#1F1F1F</color>

    <!--
      Customer-balance colours, deliberately separate from green_got/red_gave.

      The owner wants the shopkeeper's convention: money a customer OWES the shop
      (a receivable the owner must collect) shows RED with a minus, and money the
      SHOP owes shows GREEN with a plus. That is the opposite of the good=green
      instinct, so these live on their own names — flipping them here can never
      reach into the cashbook, cheques, expiry, or plans, which keep the plain
      green=good / red=bad meaning.
    -->
    <color name="bal_owed_to_me">#8E2226</color>
    <color name="bal_i_owe">#0A5A44</color>
    <!-- Bright variants for use ON the dark green party header only -->
    <color name="bal_owed_to_me_on_dark">#FFA8A8</color>
    <color name="bal_i_owe_on_dark">#7FE3C4</color>
    <color name="section_insights">#1E5A4E</color>
    <color name="section_insights_soft">#A8CBC2</color>
    <color name="section_followup">#3F6032</color>
    <color name="section_followup_soft">#BCD3AF</color>

    <!--
      Home tiles. Each feature gets a tint of the section colour it already
      belongs to — khata green, cheques teal, plans olive, bills gold — so the
      grid is coloured by meaning rather than decoration, and a shopkeeper
      reaching for the cheque book finds the same teal it has always had.

      Kept pale on purpose: thirteen saturated cards would fight each other
      and the header above them. The icon carries the full-strength colour.
    -->
    <color name="tile_khata_bg">#E6F0EA</color>
    <color name="tile_cashbook_bg">#E4EFE8</color>
    <color name="tile_cheques_bg">#E3EEEC</color>
    <color name="tile_bills_bg">#F3EEDD</color>
    <color name="tile_plans_bg">#EBF0E2</color>
    <color name="tile_stock_bg">#F5EAE4</color>
    <color name="tile_calc_bg">#E9EDF0</color>
    <color name="tile_insights_bg">#E8EDF2</color>
    <color name="tile_zakat_bg">#F1EDE0</color>
    <color name="tile_card_bg">#EDEAF2</color>
    <color name="tile_backup_bg">#E5EEF0</color>
    <color name="tile_settings_bg">#ECEDEA</color>
    <color name="tile_bin_bg">#F2E9E9</color>
    <color name="tile_invoice_bg">#F6E6ED</color>
    <color name="tile_followup_bg">#E9EFE3</color>

    <color name="tile_stock_fg">#8A4B2A</color>
    <color name="tile_calc_fg">#3A5068</color>
    <color name="tile_insights_fg">#2F4C6B</color>
    <color name="tile_card_fg">#514476</color>
    <color name="tile_backup_fg">#1D5C66</color>
    <color name="tile_settings_fg">#4A4A45</color>
    <color name="tile_bin_fg">#8C3A3A</color>
    <color name="tile_invoice_fg">#8C3F5E</color>
    <color name="tile_followup_fg">#3F6032</color>  <!-- deep leaf green: collection/recovery reads as growth, and no other tile owns this hue -->

    <!--
      The screen behind the grid: page colour easing into the header's green
      at the very top, so the tiles sit on something rather than a flat sheet.
    -->
    <color name="page_grad_top">#EDF1EC</color>
    <color name="page_grad_bottom">#F7F6F2</color>

    <!--
      The header behind the balance, on Home, Khata and Business settings.

      Brand green running into the logo's own deep green, so the header, the
      launcher icon, the splash and every other section header read as one
      family. It starts on exactly brand_green, the status-bar colour, so the
      bar and the header meet with no seam.

      Measured (WCAG), against the darkest stop: white title 7.75:1, the quiet
      header text 5.74:1, gold outlines 5.72:1, both summary boxes 6.65:1.
      Everything clears 4.5:1. The maroon it replaces read as a different app
      beside the green logo.
    -->
    <color name="header_grad_start">#1B5E3A</color>
    <color name="header_grad_mid">#154D30</color>
    <color name="header_grad_end">#0E3A23</color>

    <!--
      The quiet type on that header: the tagline, the "Net balance" label, the
      backup age, the eye toggle. A green-tinted off-white, so it belongs to
      the green header; pure white would compete with the figures.
    -->
    <color name="header_on_dark">#CDE3D5</color>

    <!--
      The two summary boxes on the green header.

      "I have to give" is green on a green header, so its fill is lifted to a
      near-white mint: it stands off the header on lightness (6.65:1) instead
      of disappearing into the same hue, and its green figure still reads at
      7.04:1. "I have to get" keeps its warm red fill (figure 7.48:1).
    -->
    <color name="summary_get_bg">#FBEAE6</color>
    <color name="summary_give_bg">#E3F1E8</color>
    <!-- Neutral card for the "settled" count — its own light background, same pattern as get/give, not the dark header's own text colour repurposed for a light card. -->
    <color name="summary_settled_bg">#E6E3D9</color>

    <!-- Behind the launcher icon, matching the cream inside the logo's rim. -->
    <!-- The logo tile's own face green, sampled from it, so a launcher mask
         that reaches past the gold rim meets more of the tile rather than a
         cream plate the logo looks stuck onto. -->
    <color name="icon_background">#035023</color>
    <!--
      A picked row in a list. Pale enough that the name and the balance on top
      of it stay as readable as on any other row — a selection should show
      which rows are chosen, not make them harder to check before deleting.
    -->
    <color name="row_selected">#33C8A05A</color>
    <!-- The thin rule under a field. Visible, never competing with the text. -->
    <color name="hairline">#33000000</color>
</resources>
