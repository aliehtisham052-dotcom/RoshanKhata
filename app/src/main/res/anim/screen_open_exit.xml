<?xml version="1.0" encoding="utf-8"?>
<!--
  The screen being left behind holds still and stays lit.

  It sits underneath while the new screen fades in over it, so the eye never
  sees a gap. Held rather than left empty because an omitted exit animation
  lets the platform substitute its own.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="180"
    android:fromAlpha="1.0"
    android:toAlpha="1.0" />
